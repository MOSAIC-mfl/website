{
  "name": "website",
  "version": "0.0.1",
  "description": "MOSAIC — the shared spatial intelligence network for the CGIAR Multifunctional Landscapes Science Programme (frontend; reads mosaic-api)",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "check": "astro check",
    "test": "vitest run",
    "gen:api": "npx --yes openapi-typescript@7.13.0 contract/openapi.json -o src/lib/api/schema.d.ts && node scripts/gen-record-types.mjs",
    "api:static": "node scripts/serve-static-api.mjs",
    "gen:labels": "node scripts/gen-labels.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.4",
    "@maplibre/maplibre-gl-compare": "0.5.0",
    "astro": "7.4.7",
    "events": "3.3.0",
    "geotiff": "2.1.3",
    "maplibre-gl": "6.14.0",
    "openapi-fetch": "^0.17.0",
    "pmtiles": "3.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "22.20.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "globals": "^17.14.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
