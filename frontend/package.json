{
  "name": "mosaic-web",
  "version": "0.0.1",
  "description": "MOSAIC website — consumes mosaic-api (static API on GitHub Pages or the live API)",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript contract/openapi.json -o src/lib/api/schema.d.ts && node scripts/gen-record-types.mjs",
    "api:static": "node scripts/serve-static-api.mjs"
  },
  "dependencies": {
    "@astrojs/react": "3.6.0",
    "@maplibre/maplibre-gl-compare": "0.5.0",
    "astro": "4.16.19",
    "events": "3.3.0",
    "geotiff": "2.1.3",
    "maplibre-gl": "6.14.0",
    "openapi-fetch": "^0.17.0",
    "pmtiles": "3.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "10.13.0",
    "globals": "^17.13.0",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.5.4",
    "vitest": "^2.1.9"
  }
}
