{
 "openapi": "3.1.0",
 "info": {
  "title": "MOSAIC API",
  "description": "Read-only API of MOSAIC, a network of metadata. It gathers records from several catalogues (MOSAIC, CGIAR Climate Data Hub, ...) and serves them in the MOSAIC metadata model. Each resource keeps its provenance: MOSAIC links to the data where it lives.",
  "version": "0.1.0"
 },
 "paths": {
  "/v1/sources": {
   "get": {
    "tags": [
     "catalogue"
    ],
    "summary": "Sources",
    "description": "The catalogues MOSAIC reads (MOSAIC, CGIAR Climate Data Hub, ...): how many records each\none has, and the date and outcome of the last harvest.",
    "operationId": "sources_v1_sources_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/SourceOut"
         },
         "type": "array",
         "title": "Response Sources V1 Sources Get"
        }
       }
      }
     },
     "422": {
      "description": "Unprocessable Content",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     },
     "404": {
      "description": "Not Found",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     }
    }
   }
  },
  "/v1/filters": {
   "get": {
    "tags": [
     "catalogue"
    ],
    "summary": "Filters",
    "description": "Read once before searching: versions and totals, the filters of GET /v1/resources with\nevery option (value, label, count), and display labels for the other coded values.",
    "operationId": "filters_v1_filters_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/FiltersOut"
        }
       }
      }
     },
     "422": {
      "description": "Unprocessable Content",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     },
     "404": {
      "description": "Not Found",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     }
    }
   }
  },
  "/v1/resources": {
   "get": {
    "tags": [
     "resources"
    ],
    "summary": "List Resources",
    "description": "The catalogue: search and filter. OR inside one filter (comma-separated), AND across\nfilters. Values are case-, accent- and symbol-insensitive, and a label works as well as its id.",
    "operationId": "list_resources_v1_resources_get",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 200,
       "description": "Words to search (all must match).",
       "default": "",
       "title": "Q"
      },
      "description": "Words to search (all must match)."
     },
     {
      "name": "source",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Catalogue, e.g. mosaic, cdh. Comma-separated values (OR). Values and labels: GET /v1/filters.",
       "title": "Source"
      },
      "description": "Catalogue, e.g. mosaic, cdh. Comma-separated values (OR). Values and labels: GET /v1/filters."
     },
     {
      "name": "theme",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Theme, e.g. water. Comma-separated values (OR). Values and labels: GET /v1/filters.",
       "title": "Theme"
      },
      "description": "Theme, e.g. water. Comma-separated values (OR). Values and labels: GET /v1/filters."
     },
     {
      "name": "landscape",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Living landscape, e.g. KEN-LVB. Comma-separated values (OR). Values and labels: GET /v1/filters.",
       "title": "Landscape"
      },
      "description": "Living landscape, e.g. KEN-LVB. Comma-separated values (OR). Values and labels: GET /v1/filters."
     },
     {
      "name": "geography",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Country or region, e.g. KEN. Comma-separated values (OR). Values and labels: GET /v1/filters.",
       "title": "Geography"
      },
      "description": "Country or region, e.g. KEN. Comma-separated values (OR). Values and labels: GET /v1/filters."
     },
     {
      "name": "sort",
      "in": "query",
      "required": false,
      "schema": {
       "$ref": "#/components/schemas/Sort",
       "default": "relevance"
      }
     },
     {
      "name": "order",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "$ref": "#/components/schemas/Order"
        },
        {
         "type": "null"
        }
       ],
       "description": "asc | desc; default: the sort's natural order.",
       "title": "Order"
      },
      "description": "asc | desc; default: the sort's natural order."
     },
     {
      "name": "page",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 100000,
       "minimum": 1,
       "default": 1,
       "title": "Page"
      }
     },
     {
      "name": "page_size",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 1,
       "default": 20,
       "title": "Page Size"
      }
     },
     {
      "name": "include_facets",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "description": "Also return the count of each filter value over all the results.",
       "default": false,
       "title": "Include Facets"
      },
      "description": "Also return the count of each filter value over all the results."
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ResourcePage"
        }
       }
      }
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Unprocessable Content"
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Not Found"
     }
    }
   }
  },
  "/v1/resources/{source_id}/{local_id}": {
   "get": {
    "tags": [
     "resources"
    ],
    "summary": "Get Resource",
    "description": "One resource, by catalogue and id: the full record in the MOSAIC model, where it comes from\n(provenance) and how complete it is (quality).",
    "operationId": "get_resource_v1_resources__source_id___local_id__get",
    "parameters": [
     {
      "name": "source_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Source Id"
      }
     },
     {
      "name": "local_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Local Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ResourceDetail"
        }
       }
      }
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Unprocessable Content"
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Not Found"
     }
    }
   }
  },
  "/v1/landscapes": {
   "get": {
    "tags": [
     "landscapes"
    ],
    "summary": "List Landscapes",
    "description": "Every living landscape with its page sections and how many resources cover it.",
    "operationId": "list_landscapes_v1_landscapes_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/LandscapeSummaryOut"
         },
         "type": "array",
         "title": "Response List Landscapes V1 Landscapes Get"
        }
       }
      }
     },
     "422": {
      "description": "Unprocessable Content",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     },
     "404": {
      "description": "Not Found",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     }
    }
   }
  },
  "/v1/landscapes/{code}": {
   "get": {
    "tags": [
     "landscapes"
    ],
    "summary": "Get Landscape",
    "description": "One landscape page: its profile (sections and their configuration) and its data status.\nThe code is case-insensitive (KEN-LVB or ken-lvb).",
    "operationId": "get_landscape_v1_landscapes__code__get",
    "parameters": [
     {
      "name": "code",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Code"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/LandscapeOut"
        }
       }
      }
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Unprocessable Content"
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Not Found"
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "DataStatusOut": {
    "properties": {
     "total": {
      "type": "integer",
      "title": "Total"
     },
     "complete": {
      "type": "integer",
      "title": "Complete"
     },
     "incomplete": {
      "type": "integer",
      "title": "Incomplete"
     },
     "stated": {
      "type": "integer",
      "title": "Stated",
      "description": "Resources that name the landscape; the others cover it by bounding box."
     },
     "by_kind": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "By Kind"
     },
     "by_theme": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "By Theme"
     },
     "by_access": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "By Access"
     },
     "missing_minimum": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "Missing Minimum",
      "description": "Minimum field -> resources missing it."
     }
    },
    "type": "object",
    "required": [
     "total",
     "complete",
     "incomplete",
     "stated",
     "by_kind",
     "by_theme",
     "by_access",
     "missing_minimum"
    ],
    "title": "DataStatusOut",
    "description": "What the catalogue holds for the landscape and how complete it is."
   },
   "FilterOption": {
    "properties": {
     "value": {
      "type": "string",
      "title": "Value",
      "description": "What goes in the query, e.g. theme=water."
     },
     "label": {
      "type": "string",
      "title": "Label",
      "description": "What people read, from the MOSAIC vocabularies."
     },
     "count": {
      "type": "integer",
      "title": "Count",
      "description": "Resources with this value in the whole catalogue."
     }
    },
    "type": "object",
    "required": [
     "value",
     "label",
     "count"
    ],
    "title": "FilterOption"
   },
   "FiltersOut": {
    "properties": {
     "api_version": {
      "type": "string",
      "title": "Api Version"
     },
     "standard_version": {
      "type": "string",
      "title": "Standard Version"
     },
     "harvested_at": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Harvested At"
     },
     "totals": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "Totals",
      "description": "resources, complete, incomplete."
     },
     "filters": {
      "additionalProperties": {
       "items": {
        "$ref": "#/components/schemas/FilterOption"
       },
       "type": "array"
      },
      "type": "object",
      "title": "Filters",
      "description": "One entry per filter of GET /v1/resources (source, theme, landscape, geography): the values present in the catalogue, most frequent first."
     },
     "labels": {
      "additionalProperties": {
       "additionalProperties": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "object",
      "title": "Labels",
      "description": "Display labels of the other coded values a resource shows (resource_type, data_kind, access, method, geometry, spatial, license, status)."
     }
    },
    "type": "object",
    "required": [
     "api_version",
     "standard_version",
     "harvested_at",
     "totals",
     "filters",
     "labels"
    ],
    "title": "FiltersOut",
    "description": "Everything a client needs before searching: versions, totals, the filters of\nGET /v1/resources with their options, and display labels for the other coded values."
   },
   "LandscapeOut": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code",
      "description": "Landscape code, e.g. KEN-LVB."
     },
     "slug": {
      "type": "string",
      "title": "Slug",
      "description": "Code in lower case, used in page URLs."
     },
     "label": {
      "type": "string",
      "title": "Label"
     },
     "countries": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Countries"
     },
     "bbox": {
      "anyOf": [
       {
        "items": {
         "type": "number"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Bbox"
     },
     "title": {
      "type": "string",
      "title": "Title"
     },
     "summary": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Summary"
     },
     "status": {
      "type": "string",
      "title": "Status",
      "description": "draft | review | published"
     },
     "curated": {
      "type": "boolean",
      "title": "Curated",
      "description": "false = the default page (no profile written yet)."
     },
     "sections": {
      "items": {
       "$ref": "#/components/schemas/SectionOut"
      },
      "type": "array",
      "title": "Sections"
     },
     "counts": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "Counts"
     },
     "records": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Records",
      "description": "Catalogue records the profile names (source:id)."
     },
     "credits": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Credits"
     },
     "origin": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Origin"
     },
     "data_status": {
      "$ref": "#/components/schemas/DataStatusOut"
     },
     "linked": {
      "items": {
       "$ref": "#/components/schemas/ResourceSummary"
      },
      "type": "array",
      "title": "Linked",
      "description": "Named records that cover the landscape."
     }
    },
    "type": "object",
    "required": [
     "code",
     "slug",
     "label",
     "countries",
     "bbox",
     "title",
     "summary",
     "status",
     "curated",
     "sections",
     "counts",
     "records",
     "credits",
     "origin",
     "data_status",
     "linked"
    ],
    "title": "LandscapeOut"
   },
   "LandscapeSummaryOut": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code",
      "description": "Landscape code, e.g. KEN-LVB."
     },
     "slug": {
      "type": "string",
      "title": "Slug",
      "description": "Code in lower case, used in page URLs."
     },
     "label": {
      "type": "string",
      "title": "Label"
     },
     "countries": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Countries"
     },
     "bbox": {
      "anyOf": [
       {
        "items": {
         "type": "number"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Bbox"
     },
     "title": {
      "type": "string",
      "title": "Title"
     },
     "summary": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Summary"
     },
     "status": {
      "type": "string",
      "title": "Status",
      "description": "draft | review | published"
     },
     "curated": {
      "type": "boolean",
      "title": "Curated",
      "description": "false = the default page (no profile written yet)."
     },
     "sections": {
      "items": {
       "$ref": "#/components/schemas/SectionOut"
      },
      "type": "array",
      "title": "Sections"
     },
     "counts": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "Counts"
     },
     "records": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Records",
      "description": "Catalogue records the profile names (source:id)."
     }
    },
    "type": "object",
    "required": [
     "code",
     "slug",
     "label",
     "countries",
     "bbox",
     "title",
     "summary",
     "status",
     "curated",
     "sections",
     "counts",
     "records"
    ],
    "title": "LandscapeSummaryOut"
   },
   "Order": {
    "type": "string",
    "enum": [
     "asc",
     "desc"
    ],
    "title": "Order"
   },
   "Problem": {
    "properties": {
     "type": {
      "type": "string",
      "title": "Type",
      "default": "about:blank"
     },
