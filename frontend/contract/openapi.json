  "/v1/resources": {
   "get": {
    "tags": [
     "resources"
    ],
    "summary": "List Resources",
    "description": "Search and filter. OR inside one filter (comma-separated), AND across filters.",
    "operationId": "list_resources_v1_resources_get",
