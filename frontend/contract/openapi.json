     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 200,
       "description": "Words to search (all must match).",
       "default": "",
       "title": "Q"
      },
      "description": "Words to search (all must match)."
     },
     {
      "name": "source",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Comma-separated values (OR).",
       "title": "Source"
      },
      "description": "Comma-separated values (OR)."
     },
     {
      "name": "resource_type",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Comma-separated values (OR).",
       "title": "Resource Type"
      },
      "description": "Comma-separated values (OR)."
     },
     {
      "name": "theme",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Comma-separated values (OR).",
       "title": "Theme"
      },
      "description": "Comma-separated values (OR)."
     },
     {
      "name": "landscape",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Comma-separated values (OR).",
       "title": "Landscape"
      },
      "description": "Comma-separated values (OR)."
     },
     {
      "name": "geography",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Comma-separated values (OR).",
       "title": "Geography"
      },
      "description": "Comma-separated values (OR)."
     },
     {
      "name": "data_kind",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Comma-separated values (OR).",
       "title": "Data Kind"
      },
      "description": "Comma-separated values (OR)."
     },
     {
      "name": "geometry",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Comma-separated values (OR).",
       "title": "Geometry"
      },
      "description": "Comma-separated values (OR)."
     },
     {
      "name": "spatial",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Comma-separated values (OR).",
       "title": "Spatial"
      },
      "description": "Comma-separated values (OR)."
     },
     {
      "name": "method",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Comma-separated values (OR).",
       "title": "Method"
      },
      "description": "Comma-separated values (OR)."
     },
     {
      "name": "access",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Comma-separated values (OR).",
       "title": "Access"
      },
      "description": "Comma-separated values (OR)."
     },
     {
      "name": "license",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Comma-separated values (OR).",
       "title": "License"
      },
      "description": "Comma-separated values (OR)."
     },
     {
      "name": "status",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 500
        },
        {
         "type": "null"
        }
       ],
       "description": "Comma-separated values (OR).",
       "title": "Status"
      },
      "description": "Comma-separated values (OR)."
     },
     {
      "name": "bbox",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^-?[\\d.]+,-?[\\d.]+,-?[\\d.]+,-?[\\d.]+$"
        },
        {
         "type": "null"
        }
       ],
       "description": "west,south,east,north",
       "title": "Bbox"
      },
      "description": "west,south,east,north"
     },
     {
      "name": "year_from",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer",
         "maximum": 3000,
         "minimum": 1000
        },
        {
         "type": "null"
        }
       ],
       "title": "Year From"
      }
     },
     {
      "name": "year_to",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer",
         "maximum": 3000,
         "minimum": 1000
        },
        {
         "type": "null"
        }
       ],
       "title": "Year To"
      }
     },
     {
      "name": "sort",
      "in": "query",
      "required": false,
      "schema": {
       "$ref": "#/components/schemas/Sort",
       "default": "relevance"
      }
     },
     {
      "name": "order",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "$ref": "#/components/schemas/Order"
        },
        {
         "type": "null"
        }
       ],
       "description": "asc | desc; default: the sort's natural order.",
       "title": "Order"
      },
      "description": "asc | desc; default: the sort's natural order."
     },
     {
      "name": "page",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 100000,
       "minimum": 1,
       "default": 1,
       "title": "Page"
      }
     },
     {
      "name": "page_size",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 1,
       "default": 20,
       "title": "Page Size"
      }
     },
     {
      "name": "include_facets",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": false,
       "title": "Include Facets"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ResourcePage"
        }
       }
      }
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Unprocessable Content"
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Not Found"
     }
    }
   }
  },
