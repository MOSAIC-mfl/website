 "components": {
  "schemas": {
   "DataStatusOut": {
    "properties": {
     "total": {
      "type": "integer",
      "title": "Total"
     },
     "complete": {
      "type": "integer",
      "title": "Complete"
     },
     "incomplete": {
      "type": "integer",
      "title": "Incomplete"
     },
     "stated": {
      "type": "integer",
      "title": "Stated",
      "description": "Resources that name the landscape; the others cover it by bounding box."
     },
     "by_kind": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "By Kind"
     },
     "by_theme": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "By Theme"
     },
     "by_access": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "By Access"
     },
     "missing_minimum": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "Missing Minimum",
      "description": "Minimum field -> resources missing it."
     }
    },
    "type": "object",
    "required": [
     "total",
     "complete",
     "incomplete",
     "stated",
     "by_kind",
     "by_theme",
     "by_access",
     "missing_minimum"
    ],
    "title": "DataStatusOut",
    "description": "What the catalogue holds for the landscape and how complete it is."
   },
   "Labels": {
    "properties": {
     "labels": {
      "additionalProperties": {
       "additionalProperties": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "object",
      "title": "Labels"
     }
    },
    "type": "object",
    "required": [
     "labels"
    ],
    "title": "Labels",
    "description": "Display labels for facet values, per facet (from the MOSAIC vocabularies)."
   },
   "LandscapeOut": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code",
      "description": "Landscape code, e.g. KEN-LVB."
     },
     "slug": {
      "type": "string",
      "title": "Slug",
      "description": "Code in lower case, used in page URLs."
     },
     "label": {
      "type": "string",
      "title": "Label"
     },
     "countries": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Countries"
     },
     "bbox": {
      "anyOf": [
       {
        "items": {
         "type": "number"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Bbox"
     },
     "title": {
      "type": "string",
      "title": "Title"
     },
     "summary": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Summary"
     },
     "status": {
      "type": "string",
      "title": "Status",
      "description": "draft | review | published"
     },
     "curated": {
      "type": "boolean",
      "title": "Curated",
      "description": "false = the default page (no profile written yet)."
     },
     "sections": {
      "items": {
       "$ref": "#/components/schemas/SectionOut"
      },
      "type": "array",
      "title": "Sections"
     },
     "counts": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "Counts"
     },
     "records": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Records",
      "description": "Catalogue records the profile names (source:id)."
     },
     "credits": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Credits"
     },
     "origin": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Origin"
     },
     "data_status": {
      "$ref": "#/components/schemas/DataStatusOut"
     },
     "linked": {
      "items": {
       "$ref": "#/components/schemas/ResourceSummary"
      },
      "type": "array",
      "title": "Linked",
      "description": "Named records that cover the landscape."
