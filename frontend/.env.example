# Copy to .env and adjust. Read at build time (Astro PUBLIC_* variables end up in the browser code).

# 'live'  : a running API  -> cd ../mosaic-api && python -m mosaic_api serve
PUBLIC_MOSAIC_API_MODE=live
PUBLIC_MOSAIC_API_URL=http://127.0.0.1:8000

# 'static': the files mosaic-api exports (what GitHub Pages serves). Locally:
#   cd ../mosaic-api && python -m mosaic_api export   then   npm run api:static   (serves ../mosaic-api/site on :8001)
# PUBLIC_MOSAIC_API_MODE=static
# PUBLIC_MOSAIC_API_URL=http://127.0.0.1:8001

# Optional, development only: read the map explorers' data files from a local folder instead of where
# their profiles say they are served (e.g. without network). The folder holds one sub-folder per
# landscape code, with the same layout as the profile's data (meta/, tiles/, climate/, ...):
#   PORT=8002 node scripts/serve-static-api.mjs D:/data/profiles     (serves with CORS and byte ranges)
# PUBLIC_MOSAIC_PROFILE_DATA=http://127.0.0.1:8002
