---
import '../styles/global.css'
import '../styles/badges.css'
import '../styles/breadcrumb.css'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'

interface Props {
  title: string
  description?: string
  ogImage?: string
  /** Keep the page out of search results (placeholders). */
  noindex?: boolean
}

const {
  title,
  // Same framing as About › What MOSAIC is: an entry point, never a store.
  description = 'MOSAIC is an open network for living landscapes: the entry point to the data and research produced around each one. With support from the CGIAR Multifunctional Landscapes Science Program.',
  ogImage = '/website/og-image.png',
  noindex = false,
} = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const pageTitle = title === 'Home'
  ? 'MOSAIC — an open network for living landscapes'
  : `${title} | MOSAIC`
const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Set the colour theme before first paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('mosaic-theme')
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          }
          if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark')
        } catch (e) {}
      })()
    </script>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <!-- Self-hosted Noto Sans (body, headlines) and Noto Serif (titles): fetched early so the
         first paint uses them; @font-face rules in styles/variables.css. -->
    <link rel="preload" href={`${base}/fonts/NotoSans-Variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/NotoSerif-Variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content="MOSAIC — CGIAR MFL Science Program" />
    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />


    <!-- Theme toggle wiring (runs once, shared by every .js-theme-toggle button). -->
    <script is:inline>
      (function () {
        var root = document.documentElement
        var btns = document.querySelectorAll('.js-theme-toggle')

        function syncButtons(isDark) {
          for (var i = 0; i < btns.length; i++) {
            // fixed name ("Dark theme") + pressed state: the name never contradicts the state
            btns[i].setAttribute('aria-pressed', String(isDark))
          }
        }

        syncButtons(root.getAttribute('data-theme') === 'dark')

        for (var j = 0; j < btns.length; j++) {
          btns[j].addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
            if (next === 'dark') root.setAttribute('data-theme', 'dark')
            else root.removeAttribute('data-theme')
            try { localStorage.setItem('mosaic-theme', next) } catch (e) {}
            syncButtons(next === 'dark')
          })
        }
      })()
    </script>
  </body>
</html>
