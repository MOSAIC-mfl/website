---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/ui/Icon.astro'
import HeroMosaic from '../components/home/HeroMosaic.astro'
import { loadDatasets } from '../utils/loadDatasets'
import { countCountries } from '../utils/countries'

const base = import.meta.env.BASE_URL
const datasets = await loadDatasets()
const totalDatasets = datasets.length
// 'GLB' is the global / cross-landscape value, not a landscape; likewise the
// 'Global' and regional values of `country` are not countries.
const countries = countCountries(datasets)
const landscapes = [...new Set(datasets.filter((d) => d.living_landscape !== 'GLB').map((d) => d.living_landscape))].length

// "What is a living landscape?" — counts come from the landscape boundaries
// (optional file: without it the sentence drops the numbers).
const optional = import.meta.glob<{ default: Record<string, unknown> }>(
  '../../data/landscape_geo.json',
  { eager: true },
)
const geoFile = (Object.values(optional)[0]?.default ?? {}) as { landscapes?: Record<string, { countries: string[] }> }
const geo = geoFile.landscapes ?? {}
const allLandscapes = Object.keys(geo).length
const allCountries = new Set(Object.values(geo).flatMap((l) => l.countries)).size

// The journey, in the language of About › What MOSAIC is (connect / integrate / support).
const steps = [
  {
    num: '1', icon: 'search', tint: 'teal', title: 'Find what exists',
    body: 'Pick a landscape or search by topic. What is scattered across centres, projects and partners becomes one picture: what exists for a place, who made it and how ready it is to use.',
    href: `${base}/catalogue`, link: 'Search the catalogue',
  },
  {
    num: '2', icon: 'link', tint: 'amber', title: 'Go to the source',
    body: 'Each entry links to where the data is kept, at the organisation that produced it. MOSAIC connects, it does not duplicate: no copies are kept here.',
    href: `${base}/about#overview`, link: 'More about MOSAIC',
  },
  {
    num: '3', icon: 'upload', tint: 'terracotta', title: 'Add your own',
    body: 'Register a dataset in a few minutes so others can find it and build on it. Open to anyone working on these places. Research and knowledge resources are coming next.',
    href: `${base}/about#contribute`, link: 'How to contribute',
  },
] as const

// Each audience gets a way in: where someone like them would start.
const audiences = [
  { icon: 'search', who: 'Researchers', what: 'looking for landscape data and research', href: `${base}/catalogue` },
  { icon: 'upload', who: 'Institutions', what: 'sharing data and research', href: `${base}/about#contribute` },
  { icon: 'map-pin', who: 'Landscape teams', what: 'coordinating data across places', href: `${base}/landscapes` },
  { icon: 'sparkles', who: 'Decision-makers', what: 'comparing environmental and social information', href: `${base}/landscapes` },
  { icon: 'database', who: 'Data stewards', what: 'making their work easier to find and reuse', href: `${base}/about#metadata` },
  { icon: 'users', who: 'Funders and partners', what: 'tracking evidence across initiatives', href: `${base}/about#overview` },
] as const
---

<BaseLayout title="Home">

  <!-- ── Hero ──────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content" data-reveal-stagger>
        <p class="hero-eyebrow">An open network for living landscapes</p>
        <h1 class="hero-headline">Data and research for living landscapes — connected</h1>
        <p class="hero-sub">
          MOSAIC is where everything about a living landscape comes together — the entry point
          to the data and research produced around it, by many organisations.
        </p>
        <p class="hero-support">
          Each piece stays with whoever produced it: MOSAIC describes it, links to it and shows
          how ready it is to use.
        </p>
        <div class="hero-actions">
          <a href={`${base}/landscapes`} class="btn btn-hero-primary">
            <Icon name="map-pin" size={18} aria-hidden="true" /> Explore the landscapes
          </a>
          <a href={`${base}/about#contribute`} class="btn btn-hero-ghost">
            <Icon name="upload" size={18} aria-hidden="true" /> Contribute
          </a>
        </div>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <HeroMosaic />
    </div>
  </section>

  <!-- ── Stats bar (floating card) ─────────────────────────────────── -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-card" data-reveal-stagger>
        <a class="stat-item" href={`${base}/catalogue`}>
          <span class="stat-icon" aria-hidden="true"><Icon name="database" size={24} /></span>
          <span class="stat-text">
            <span class="stat-number">{totalDatasets}</span>
            <span class="stat-label">Datasets catalogued</span>
          </span>
        </a>
        <div class="stat-divider" aria-hidden="true"></div>
        <a class="stat-item" href={`${base}/landscapes`}>
          <span class="stat-icon" aria-hidden="true"><Icon name="mountains" size={24} /></span>
          <span class="stat-text">
            <span class="stat-number">{landscapes}</span>
            <span class="stat-label">Landscapes with data</span>
          </span>
        </a>
        <div class="stat-divider" aria-hidden="true"></div>
        <a class="stat-item" href={`${base}/catalogue`}>
          <span class="stat-icon" aria-hidden="true"><Icon name="globe" size={24} /></span>
          <span class="stat-text">
            <span class="stat-number">{countries}</span>
            <span class="stat-label">Countries with data</span>
          </span>
        </a>
      </div>
      <p class="stats-today">
        Today MOSAIC lists datasets. Research for each landscape is being added.
      </p>
    </div>
  </section>

  <!-- ── What is a living landscape? ───────────────────────────────── -->
  <section class="section-subtle">
    <div class="container ll">
      <div class="ll-text">
        <p class="section-eyebrow">New to living landscapes?</p>
        <h2 class="ll-title">What is a living landscape?</h2>
        <svg class="section-wavy" width="72" height="9" viewBox="0 0 64 8" fill="none" aria-hidden="true">
          <path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
        <p class="ll-lead">
          A living landscape is a real place — a river basin, a mountain range, a coastal delta —
          where farms, forests, water and the people who depend on them are looked at together,
          not one at a time.
        </p>
        <p class="ll-body">
          The CGIAR Multifunctional Landscapes Science Programme works with local communities,
          governments and partners in {allLandscapes > 0 ? `${allLandscapes} of these landscapes, in ${allCountries} countries` : 'these landscapes'} across
          Latin America, Africa and Asia. Each covers tens of thousands of hectares or more, and is
          where solutions are tried on the ground to learn what works, where and why.
        </p>
        <a class="ll-link" href={`${base}/landscapes`}>
          Meet the landscapes <Icon name="arrow-right" size={16} aria-hidden="true" />
        </a>
      </div>
      <div class="ll-art">
        <img
          src={`${base}/illustrations/living-landscape.webp`}
          alt="Illustration of a living landscape — hills, a river, forest, fields with grazing cattle and a farmhouse — ringed by the parts it brings together: water, forests, biodiversity, people and livelihoods, agriculture, land and soils, and climate. Together they form a connected socio-ecological system."
          width="1387"
          height="745"
          loading="lazy"
          decoding="async"
        />
        <p class="ll-parts">Water · Forests · Biodiversity · People and livelihoods · Agriculture · Land and soils · Climate</p>
      </div>
    </div>
  </section>

  <!-- ── How MOSAIC works ──────────────────────────────────────────── -->
  <section class="section-white">
    <div class="container">
      <div class="section-head">
        <p class="section-eyebrow section-eyebrow--amber">In three steps</p>
        <h2 class="section-title-center">How MOSAIC works</h2>
        <svg class="section-wavy" width="72" height="9" viewBox="0 0 64 8" fill="none" aria-hidden="true">
          <path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
      <ol class="how" data-reveal-stagger>
        {steps.map((st) => (
          <li class="how-step" data-tint={st.tint}>
            <span class="how-top">
              <span class="how-num" aria-hidden="true">{st.num}</span>
              <span class="how-ico" aria-hidden="true"><Icon name={st.icon} size={22} /></span>
            </span>
            <h3 class="how-title">{st.title}</h3>
            <p class="how-body">{st.body}</p>
            <a class="how-link" href={st.href}>{st.link} <Icon name="arrow-right" size={16} aria-hidden="true" /></a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Who is MOSAIC for? ────────────────────────────────────────── -->
  <section class="section-subtle">
    <div class="container">
      <div class="section-head">
        <p class="section-eyebrow section-eyebrow--amber">Open to all</p>
        <h2 class="section-title-center">Who is MOSAIC for?</h2>
        <svg class="section-wavy" width="72" height="9" viewBox="0 0 64 8" fill="none" aria-hidden="true">
          <path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
      <ul class="who-grid" data-reveal-stagger>
        {audiences.map((a) => (
          <li>
            <a class="who-item" href={a.href}>
              <span class="who-ico" aria-hidden="true"><Icon name={a.icon} size={20} /></span>
              <span><strong>{a.who}</strong> {a.what}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero (light) ──────────────────────────────────────────── */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-start;
    /* Tall enough that the text sits in the open sky above the hills: the
       banner is ~1.83:1 and its hills start ~70% down on the left. */
    min-height: clamp(720px, 54.7vw, 880px);
    /* the banner's sky is Warm Sand too, so the band above the shifted
       banner shows no seam */
    background-color: var(--mosaic-sand);
    color: var(--mosaic-ink);
    padding: 3.5rem 0 6.5rem;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }
  /* wide enough for a 3-line headline, narrow enough to stop before the tree */
  .hero-content { max-width: 620px; }

  /* Full-bleed landscape banner behind the text, kept to its bottom-right
     corner (route and MOSAIC mark) when the hero is narrower than the image;
     HeroMosaic's SVG does the cover/right-bottom fit itself. */
  .hero-art {
    position: absolute;
    /* shifted down so the hills start below the buttons; the gap above is
       the hero background, which matches the banner's sky */
    inset: 6rem 0 -6rem;
    pointer-events: none;
    z-index: 1;
  }

  .hero-eyebrow {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* the hero is light in both themes: the fixed text amber, not the themed one */
    color: var(--mosaic-amber-text);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }
  .hero-headline {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--mosaic-ink);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }
  .hero-sub {
    font-size: var(--text-lg);
    /* Fixed grey (not a theming token) — this hero is always light in both
       themes, so the subtitle must stay dark-on-sand and never invert. */
    color: #4B5563;
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: var(--space-4);
  }
  .hero-support {
    font-size: var(--text-base);
    color: #5B6B72;
    line-height: 1.65;
    max-width: 560px;
    margin: 0 0 var(--space-8);
  }
  .hero-actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .hero-actions .btn { display: inline-flex; align-items: center; gap: var(--space-2); }

  .btn-hero-primary {
    background-color: var(--mosaic-amber-text);
    color: var(--color-white);
    border-color: var(--mosaic-amber-text);
    font-weight: 600;
    padding: var(--space-3) var(--space-6);
  }
  .btn-hero-primary:hover { background-color: #7D4D10; border-color: #7D4D10; color: var(--color-white); }
  .btn-hero-ghost {
    /* Sits on the hero band, which stays light in BOTH themes — use the
       never-remapped white, not --color-surface (dark-on-dark in dark mode). */
    background-color: var(--color-white);
    color: var(--mosaic-teal);
    border: 2px solid var(--mosaic-teal);
    font-weight: 600;
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
    cursor: pointer;
  }
  .btn-hero-ghost:hover { background-color: var(--mosaic-teal); color: var(--color-white); }

  /* ── Stats (floating card) ─────────────────────────────────── */
  .stats-section {
    background-color: var(--color-bg);
    padding: 0 0 var(--space-16);
  }
  .stats-card {
    position: relative;
    z-index: 5;
    margin-top: -3.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-8);
  }
  .stat-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex: 1 1 0;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-md);
  }
  .stat-item:hover .stat-label { text-decoration: underline; }
  .stats-today { margin: var(--space-4) 0 0; text-align: center; font-size: var(--text-sm); color: var(--color-muted); }
  .stat-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* neutral icons on this page (Lizeth 2026-11-10): grey disc, dark grey icon;
       both tokens remap in the dark theme */
    background-color: var(--color-gray-100);
    color: var(--color-gray-700);
  }
  .stat-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .stat-number {
    font-family: var(--font-title);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .stat-label { font-size: var(--text-sm); color: var(--color-muted); font-weight: 400; }
  .stat-divider { width: 1px; align-self: stretch; background-color: var(--color-border); flex-shrink: 0; margin: var(--space-1) 0; }

  /* ── Sections ──────────────────────────────────────────────── */
  .section-white { background-color: var(--color-bg); padding: var(--space-16) 0; }
  .section-subtle { background-color: var(--color-gray-50); padding: var(--space-16) 0; }
  .section-title-center { text-align: center; margin-bottom: var(--space-12); }

  /* Centred section head: eyebrow + title + wavy underline */
  .section-head { text-align: center; margin-bottom: var(--space-12); }
  .section-head .section-title-center { margin-bottom: var(--space-2); }
  .section-eyebrow {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-moss-text);
  }
  .section-wavy { display: inline-block; color: var(--color-link); }
  .section-eyebrow--amber { color: var(--color-amber-text); }


  /* ── "Who is MOSAIC for?" audience grid ─────────────────────── */
  .who-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6) var(--space-8);
  }
  .who-item {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    color: var(--color-text);
    line-height: 1.45;
    text-decoration: none;
    border-radius: var(--radius-md);
  }
  .who-item:hover { color: var(--color-text); }
  .who-item:hover strong { text-decoration: underline; }
  .who-item strong { font-weight: 700; }
  .who-ico {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .who-ico { background-color: var(--color-gray-100); color: var(--color-gray-700); }
  @media (max-width: 900px) { .who-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .who-grid { grid-template-columns: 1fr; } }

  /* ── What is a living landscape? ───────────────────────────── */
  .ll {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-12);
    align-items: center;
  }
  .ll-title { margin: 0 0 var(--space-2); }
  .ll-lead { font-size: var(--text-lg); color: var(--color-text); line-height: 1.6; margin: var(--space-6) 0 var(--space-4); }
  .ll-body { color: var(--color-muted); line-height: 1.7; margin: 0 0 var(--space-6); }
  .ll-link, .how-link {
    display: inline-flex; align-items: center; gap: var(--space-2);
    color: var(--color-link); font-weight: 600; text-decoration: none;
  }
  .ll-link:hover, .how-link:hover { text-decoration: underline; }

  .ll-art img { display: block; width: 100%; height: auto; }
  /* The labels are part of the picture and too small to read on a phone: there
     they are repeated as text under it. */
  .ll-parts { display: none; margin: var(--space-3) 0 0; text-align: center; font-size: var(--text-sm); color: var(--color-muted); line-height: 1.6; }
  @media (max-width: 560px) { .ll-parts { display: block; } }
  :global([data-theme='dark']) .ll-parts { color: var(--mosaic-ink); }
  /* The illustration has a transparent background and dark labels: in dark
     mode it sits on a white plate (never-remapped --color-white) so they stay readable. */
  :global([data-theme='dark']) .ll-art {
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  /* ── How MOSAIC works ──────────────────────────────────────── */
  .how {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6);
  }
  .how-step {
    --tint: var(--mosaic-teal);
    display: flex; flex-direction: column; gap: var(--space-3);
    padding: var(--space-8) var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--tint);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }
  .how-step[data-tint='amber'] { --tint: var(--mosaic-amber); }
  .how-step[data-tint='terracotta'] { --tint: var(--mosaic-terracotta); }
  .how-top { display: flex; align-items: center; justify-content: space-between; }
  .how-num {
    font-family: var(--font-title); font-size: 2.25rem; font-weight: 700; line-height: 1;
    color: var(--tint);
  }
  /* Ocean Teal is too dark on the dark surface: use its light tint there */
  :global([data-theme='dark']) .how-step[data-tint='teal'] .how-num { color: var(--mosaic-light-teal); }
  .how-ico {
    width: 44px; height: 44px; border-radius: var(--radius-full);
    display: inline-flex; align-items: center; justify-content: center;
    background-color: var(--color-gray-100); color: var(--color-gray-700);
  }
  .how-title { margin: var(--space-2) 0 0; font-size: var(--text-xl); }
  .how-body { margin: 0; color: var(--color-muted); line-height: 1.6; flex: 1; }
  .how-link { margin-top: var(--space-2); }

  @media (max-width: 900px) {
    .ll { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
    .how { grid-template-columns: minmax(0, 1fr); }
  }

  /* ── Responsive ────────────────────────────────────────────── */
  @media (max-width: 1100px) {
    .hero-content { max-width: 460px; }
    /* narrower screens bring the hills up under the text: soften them there */
    .hero-art::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(to right, rgba(247, 244, 239, 0.88) 0%, rgba(247, 244, 239, 0.6) 45%, transparent 70%);
    }
  }
  @media (max-width: 900px) {
    .stats-card { flex-wrap: wrap; }
    .stat-item { flex: 1 1 40%; }
    .stat-divider { display: none; }
  }
  @media (max-width: 767px) {
    /* text first, then the banner below it, edge to edge */
    .hero { display: block; min-height: 0; padding: 3.5rem 0 0; }
    .hero-content { max-width: none; }
    .hero-art { position: static; margin-top: var(--space-6); }
    .hero-art::after { display: none; }
    .hero-art :global(svg) {
      height: auto;
      aspect-ratio: 4 / 3;
      /* blend the banner's sky into the band above it */
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 25%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 25%);
    }
  }
  @media (max-width: 640px) {
    .stat-item { flex: 1 1 100%; }
    .stat-number { font-size: 1.75rem; }
    .stats-card { padding: var(--space-6); gap: var(--space-6); }
  }
</style>
