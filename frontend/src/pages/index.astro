---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/ui/Icon.astro'
import HeroMosaic from '../components/home/HeroMosaic.astro'

// The three catalogue figures are read from mosaic-api in the browser (script at the end), so the
// home page never needs a rebuild when the catalogue changes. Until they arrive they show a dash.
const base = import.meta.env.BASE_URL

// "What is a living landscape?" — counts come from the landscape boundaries
// (optional file: without it the sentence drops the numbers).
const optional = import.meta.glob<{ default: Record<string, unknown> }>(
  '../../data/landscape_geo.json',
  { eager: true },
)
const geoFile = (Object.values(optional)[0]?.default ?? {}) as { landscapes?: Record<string, { countries: string[] }> }
const geo = geoFile.landscapes ?? {}
const allLandscapes = Object.keys(geo).length
const allCountries = new Set(Object.values(geo).flatMap((l) => l.countries)).size

// The journey, in the language of About › What MOSAIC is (connect / integrate / support).
const steps = [
  {
    num: '1', icon: 'search', title: 'Find what exists',
    body: 'Pick a landscape or search by topic. For each place you see what exists across centers, projects and partners, who made it and how ready it is to use.',
    href: `${base}/catalogue`, link: 'Search the catalog',
  },
  {
    num: '2', icon: 'link', title: 'Go to the source',
    body: 'Each entry links to where the data is kept, at the organization that produced it. MOSAIC connects, it does not duplicate: no copies are kept here.',
    href: `${base}/about#overview`, link: 'How MOSAIC links to sources',
  },
  {
    num: '3', icon: 'upload', title: 'Add your own',
    body: 'Register a dataset so others can find it and build on it. Open to anyone working on these places. Research and knowledge resources are coming next.',
    href: `${base}/about#contribute`, link: 'Register a dataset',
  },
] as const

// Each audience gets a way in: where someone like them would start.
const audiences = [
  { who: 'Researchers', what: 'looking for landscape data and research', href: `${base}/catalogue` },
  { who: 'Institutions', what: 'sharing data and research', href: `${base}/about#contribute` },
  { who: 'Landscape teams', what: 'coordinating data across places', href: `${base}/landscapes` },
  { who: 'Decision-makers', what: 'comparing environmental and social information', href: `${base}/landscapes` },
  { who: 'Data stewards', what: 'making their work easier to find and reuse', href: `${base}/about#metadata` },
  { who: 'Funders and partners', what: 'tracking evidence across initiatives', href: `${base}/about#overview` },
] as const
---

<BaseLayout title="Home">

  <!-- ── Hero ──────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <h1 class="hero-headline">Data and research for living landscapes</h1>
        <p class="hero-sub">
          MOSAIC is the entry point to the data and research produced around each living
          landscape, by many organizations.
        </p>
        <p class="hero-support">
          Each piece stays with whoever produced it: MOSAIC describes it, links to it and shows
          how ready it is to use.
        </p>
        <div class="hero-actions">
          <a href={`${base}/landscapes`} class="btn btn-hero-primary">
            <Icon name="map-pin" size={18} aria-hidden="true" /> Explore the landscapes
          </a>
          <a href={`${base}/about#contribute`} class="btn btn-hero-ghost">
            <Icon name="upload" size={18} aria-hidden="true" /> Register a dataset
          </a>
        </div>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <HeroMosaic />
    </div>
  </section>

  <!-- ── Figures: an open line, not three dashboard tiles (review 2026-11-18) ── -->
  <section class="stats-section">
    <div class="container">
      <ul class="figures" data-stat-group>
        <li><a class="figure" href={`${base}/catalogue`}>
          <span class="stat-number" data-stat="resources">–</span>
          <span class="stat-label">datasets cataloged</span>
        </a></li>
        <li><a class="figure" href={`${base}/landscapes`}>
          <span class="stat-number" data-stat="landscapes">–</span>
          <span class="stat-label">landscapes with data</span>
        </a></li>
        <li><a class="figure" href={`${base}/catalogue`}>
          <span class="stat-number" data-stat="countries">–</span>
          <span class="stat-label">countries with data</span>
        </a></li>
      </ul>
    </div>
  </section>

  <!-- ── What is a living landscape? ───────────────────────────────── -->
  <section class="section-subtle">
    <div class="container ll">
      <div class="ll-text">
        <h2 class="ll-title">What is a living landscape?</h2>
        <svg class="section-wavy" width="72" height="9" viewBox="0 0 64 8" fill="none" aria-hidden="true">
          <path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
        <p class="ll-lead">
          A living landscape is a place such as a river basin, a mountain range or a coastal delta,
          where farms, forests, water and the people who depend on them are looked at together,
          not one at a time.
        </p>
        <p class="ll-body">
          The CGIAR Multifunctional Landscapes Science Program works with local communities,
          governments and partners in {allLandscapes > 0 ? `${allLandscapes} of these landscapes, in ${allCountries} countries` : 'these landscapes'} across
          Latin America, Africa and Asia. Each covers tens of thousands of hectares or more, and is
          where solutions are tried on the ground to learn what works, where and why.
        </p>
        <a class="ll-link" href={`${base}/landscapes`}>
          Meet the landscapes <Icon name="arrow-right" size={16} aria-hidden="true" />
        </a>
      </div>
      <div class="ll-art">
        <img
          src={`${base}/illustrations/living-landscape.webp`}
          alt="Illustration of a living landscape (hills, a river, forest, fields with grazing cattle and a farmhouse) ringed by the parts it brings together: water, forests, biodiversity, people and livelihoods, agriculture, land and soils, and climate."
          width="1387"
          height="745"
          loading="lazy"
          decoding="async"
        />
        <p class="ll-parts">Water · Forests · Biodiversity · People and livelihoods · Agriculture · Land and soils · Climate</p>
      </div>
    </div>
  </section>

  <!-- ── How MOSAIC works ──────────────────────────────────────────── -->
  <section class="section-white">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title-center">How MOSAIC works</h2>
        <svg class="section-wavy" width="72" height="9" viewBox="0 0 64 8" fill="none" aria-hidden="true">
          <path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
      <ol class="how">
        {steps.map((st) => (
          <li class="how-step">
            <span class="how-top">
              <span class="how-num" aria-hidden="true">{st.num}</span>
              <span class="how-ico" aria-hidden="true"><Icon name={st.icon} size={22} /></span>
            </span>
            <h3 class="how-title">{st.title}</h3>
            <p class="how-body">{st.body}</p>
            <a class="how-link" href={st.href}>{st.link} <Icon name="arrow-right" size={16} aria-hidden="true" /></a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Who is MOSAIC for? ────────────────────────────────────────── -->
  <section class="section-subtle">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title-center">Who is MOSAIC for?</h2>
        <svg class="section-wavy" width="72" height="9" viewBox="0 0 64 8" fill="none" aria-hidden="true">
          <path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
      <ul class="who-grid">
        {audiences.map((a) => (
          <li>
            <a class="who-item" href={a.href}>
              <span class="who-name">{a.who} <Icon name="arrow-right" size={16} aria-hidden="true" /></span>
              <span class="who-what">{a.what}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero (light) ──────────────────────────────────────────── */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-start;
    /* Short enough that the figures below show on a laptop screen without
       scrolling (Lizeth, 2026-11-18); the banner is shifted down and cropped
       at the bottom so its hills still start below the buttons. */
    min-height: clamp(540px, 38vw, 640px);
    /* the banner's sky is Warm Sand too, so the band above the shifted
       banner shows no seam */
    background-color: var(--mosaic-sand);
    color: var(--mosaic-ink);
    padding: 3.5rem 0 3rem;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }
  /* wide enough for a 3-line headline, narrow enough to stop before the tree */
  .hero-content { max-width: 620px; }

  /* Full-bleed landscape banner behind the text, kept to its bottom-right
     corner (route and MOSAIC mark) when the hero is narrower than the image;
     HeroMosaic's SVG does the cover/right-bottom fit itself. */
  .hero-art {
    position: absolute;
    /* shifted down so the hills start below the buttons; the gap above is
       the hero background, which matches the banner's sky */
    inset: 6rem 0 -10rem;
    pointer-events: none;
    z-index: 1;
  }

  .hero-headline {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    color: var(--mosaic-ink);
    margin-bottom: var(--space-6);
  }
  .hero-sub {
    font-size: var(--text-lg);
    /* Never-remapped brand ink — this hero is always light in both themes,
       so the subtitle must stay dark-on-sand and never invert. */
    color: var(--mosaic-ink);
    max-width: 560px;
    margin-bottom: var(--space-4);
  }
  .hero-support {
    font-size: var(--text-base);
    color: var(--mosaic-grey-text);
    max-width: 560px;
    margin: 0 0 var(--space-8);
  }
  .hero-actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .hero-actions .btn { display: inline-flex; align-items: center; gap: var(--space-2); }

  /* The site's one primary colour (Ocean Teal), as every other .btn-primary */
  .btn-hero-primary {
    background-color: var(--mosaic-teal);
    color: var(--color-white);
    border-color: var(--mosaic-teal);
  }
  .btn-hero-primary:hover { background-color: var(--mosaic-teal-dark); border-color: var(--mosaic-teal-dark); color: var(--color-white); }
  .btn-hero-ghost {
    /* Sits on the hero band, which stays light in BOTH themes — use the
       never-remapped white, not --color-surface (dark-on-dark in dark mode). */
    background-color: var(--color-white);
    color: var(--mosaic-teal);
    border: 2px solid var(--mosaic-teal);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
    cursor: pointer;
  }
  .btn-hero-ghost:hover { background-color: var(--mosaic-teal); color: var(--color-white); }

  /* ── Figures (open line under the hero) ───────────────────── */
  .stats-section {
    background-color: var(--color-bg);
    padding: var(--space-8) 0 var(--space-16);
  }
  .figures {
    list-style: none; margin: 0; padding: var(--space-6) 0;
    display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-4) var(--space-12);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .figures[hidden] { display: none; }
  .figure {
    display: inline-flex; align-items: baseline; gap: var(--space-3);
    color: inherit; text-decoration: none; border-radius: var(--radius-md);
  }
  .figure:hover .stat-label { text-decoration: underline; }
  /* Big figures: Noto Serif Light, tight tracking (the CGIAR MFL page's "2 million");
     tabular digits so the width does not jump when the dash becomes a number. */
  .stat-number {
    font-family: var(--font-title);
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 300;
    color: var(--color-text);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .stat-label { font-size: var(--text-base); color: var(--color-muted); font-weight: 400; }

  /* ── Sections ──────────────────────────────────────────────── */
  .section-white { background-color: var(--color-bg); padding: var(--space-16) 0; }
  .section-subtle { background-color: var(--color-gray-50); padding: var(--space-16) 0; }
  .section-title-center { margin-bottom: var(--space-12); }

  /* Section head: title + wavy underline, left-aligned like the rest of the page */
  .section-head { text-align: start; margin-bottom: var(--space-12); }
  .section-head .section-title-center { margin-bottom: var(--space-2); }
  .section-wavy { display: inline-block; color: var(--color-link); }


  /* ── "Who is MOSAIC for?" audience rows ─────────────────────
     Each audience is a link: name in the title serif with an arrow, what they do below,
     a rule above each row. Three columns, no icons. */
  .who-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--space-8);
  }
  .who-grid li { border-top: 1px solid var(--color-border); }
  .who-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) 0 var(--space-6);
    color: var(--color-muted);
    line-height: 1.5;
    text-decoration: none;
  }
  .who-name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-title);
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--color-text);
  }
  .who-name :global(svg) { color: var(--color-link); transition: transform 150ms ease-out; }
  .who-item:hover { color: var(--color-muted); }
  @media (hover: hover) {
    .who-item:hover .who-name { text-decoration: underline; text-underline-offset: 3px; }
    .who-item:hover .who-name :global(svg) { transform: translateX(3px); }
  }
  @media (prefers-reduced-motion: reduce) { .who-name :global(svg) { transition: none; } }
  @media (max-width: 900px) { .who-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .who-grid { grid-template-columns: 1fr; } }

  /* ── What is a living landscape? ───────────────────────────── */
  .ll {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-12);
    align-items: center;
  }
  .ll-title { margin: 0 0 var(--space-2); }
  .ll-lead { font-size: var(--text-lg); color: var(--color-text); margin: var(--space-6) 0 var(--space-4); }
  .ll-body { color: var(--color-muted); margin: 0 0 var(--space-6); }
  .ll-link, .how-link {
    display: inline-flex; align-items: center; gap: var(--space-2);
    color: var(--color-link); font-weight: 600; text-decoration: none;
  }
  .ll-link:hover, .how-link:hover { text-decoration: underline; }

  .ll-art img { display: block; width: 100%; height: auto; }
  /* The labels are part of the picture and too small to read on a phone: there
     they are repeated as text under it. */
  .ll-parts { display: none; margin: var(--space-3) 0 0; text-align: center; font-size: var(--text-sm); color: var(--color-muted); }
  @media (max-width: 560px) { .ll-parts { display: block; } }
  :global([data-theme='dark']) .ll-parts { color: var(--mosaic-ink); }
  /* The illustration has a transparent background and dark labels: in dark
     mode it sits on a white plate (never-remapped --color-white) so they stay readable. */
  :global([data-theme='dark']) .ll-art {
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  /* ── How MOSAIC works ──────────────────────────────────────── */
  .how {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6);
  }
  /* One card colour for all three steps: amber and terracotta mean readiness and
     access on this site, so they are not used as decoration (review 2026-11-18). */
  .how-step {
    display: flex; flex-direction: column; gap: var(--space-3);
    padding: var(--space-8) var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .how-top { display: flex; align-items: center; justify-content: space-between; }
  .how-num {
    font-family: var(--font-title); font-size: 3rem; font-weight: 300; line-height: 1; letter-spacing: -0.04em;
    color: var(--color-text);
  }
  .how-ico {
    width: 44px; height: 44px; border-radius: var(--radius-full);
    display: inline-flex; align-items: center; justify-content: center;
    background-color: var(--color-gray-100); color: var(--color-gray-700);
  }
  .how-title { margin: var(--space-2) 0 0; font-size: var(--text-xl); }
  .how-body { margin: 0; color: var(--color-muted); flex: 1; }
  .how-link { margin-top: var(--space-2); }

  @media (max-width: 900px) {
    .ll { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
    .how { grid-template-columns: minmax(0, 1fr); }
  }

  /* ── Responsive ────────────────────────────────────────────── */
  /* Wider than the banner itself (1695 px): stop stretching it, which blurs and
     oversizes it. It keeps its own size against the right edge and its left
     edge fades into the sand background. */
  @media (min-width: 1696px) {
    .hero-art {
      left: auto;
      width: 1695px;
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 22%);
      mask-image: linear-gradient(to right, transparent 0%, #000 22%);
    }
  }
  @media (max-width: 1100px) {
    .hero-content { max-width: 460px; }
    /* narrower screens bring the hills up under the text: soften them there */
    .hero-art::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(to right, rgba(247, 244, 239, 0.88) 0%, rgba(247, 244, 239, 0.6) 45%, transparent 70%);
    }
  }
  @media (max-width: 767px) {
    /* text first, then the banner below it, edge to edge */
    .hero { display: block; min-height: 0; padding: 3.5rem 0 0; }
    .hero-content { max-width: none; }
    .hero-art { position: static; margin-top: var(--space-6); }
    .hero-art::after { display: none; }
    .hero-art :global(svg) {
      height: auto;
      aspect-ratio: 4 / 3;
      /* blend the banner's sky into the band above it */
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 25%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 25%);
    }
  }
</style>

<script>
  import { fillCatalogueFigures } from '../lib/ui/catalogue-figures'

  fillCatalogueFigures(document)
</script>
