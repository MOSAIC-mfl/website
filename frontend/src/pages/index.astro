---
import BaseLayout from '../layouts/BaseLayout.astro'
import StatusBadge from '../components/ui/StatusBadge.astro'
import ContentCard from '../components/ui/ContentCard.astro'
import Icon from '../components/ui/Icon.astro'
import datasets from '../../data/datasets.json'

const base = import.meta.env.BASE_URL
const totalDatasets = datasets.length
// 'GLB' is the global / cross-landscape value, not a landscape; likewise the
// pseudo-country 'Global' carried by those records is not a country.
const countries = [...new Set(datasets.map((d) => d.country).filter((c) => c && c !== 'Global'))].length
const landscapes = [...new Set(datasets.filter((d) => d.living_landscape !== 'GLB').map((d) => d.living_landscape))].length
const featured = datasets.slice(0, 3)
---

<BaseLayout title="Home">

  <!-- ── Hero ──────────────────────────────────────────────────────────
       Text and image share the page grid (the image used to bleed to the
       window edge and outweighed the copy). Georgia appears once on this
       page, here; every other heading is Calibri Bold. -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">Open geospatial data for living landscapes</p>
        <h1 class="hero-headline">Find and share geospatial data for living landscapes</h1>
        <p class="hero-sub">
          MOSAIC connects datasets, institutions and local knowledge to make landscape
          information easier to discover, compare and use.
        </p>
        <p class="hero-support">
          Use MOSAIC to explore trusted geospatial datasets, understand where they apply, and
          contribute data from your institution, project or landscape initiative.
        </p>
        <div class="hero-actions">
          <!-- Site rule: Ocean Teal carries the primary action; Amber is an
               accent colour only (eyebrows, highlights), never a button. -->
          <a href={`${base}/catalogue`} class="btn btn-hero-primary">
            <Icon name="search" size={18} aria-hidden="true" /> Explore datasets
          </a>
          <a href={`${base}/contribute`} class="btn btn-hero-ghost">
            <Icon name="database" size={18} aria-hidden="true" /> Contribute a dataset
          </a>
        </div>
      </div>
      <!-- Cropped from hero-home.jpg (the original is kept): the decorative
           teal/green blobs and the torn sand edge were a full-bleed device and
           read as ornament once the image sits inside the grid. -->
      <div class="hero-art" aria-hidden="true">
        <img src={`${base}/illustrations/hero-home-landscape.jpg`} alt="" width="815" height="460" />
      </div>
    </div>
  </section>

  <!-- ── Figures ───────────────────────────────────────────────────────
       A plain bar, not a floating dashboard tile: no shadow, discreet
       radius, uniform teal glyphs and the numbers in Calibri. -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-bar">
        <div class="stat-item">
          <Icon name="database" size={20} class="stat-icon" aria-hidden="true" />
          <span class="stat-text">
            <span class="stat-number">{totalDatasets}</span>
            <span class="stat-label">Datasets catalogued</span>
          </span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <Icon name="mountains" size={20} class="stat-icon" aria-hidden="true" />
          <span class="stat-text">
            <span class="stat-number">{landscapes}</span>
            <span class="stat-label">Landscapes with data</span>
          </span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <Icon name="globe" size={20} class="stat-icon" aria-hidden="true" />
          <span class="stat-text">
            <span class="stat-number">{countries}</span>
            <span class="stat-label">Countries with data</span>
          </span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <Icon name="building" size={20} class="stat-icon" aria-hidden="true" />
          <span class="stat-text">
            <span class="stat-number">10</span>
            <span class="stat-label">CGIAR centres</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Entry points ──────────────────────────────────────────────────
       The one component that keeps the tinted icon circle, because these
       three are the page's main actions. -->
  <section class="section-subtle">
    <div class="container">
      <div class="section-head">
        <p class="section-eyebrow">Three ways in</p>
        <h2 class="section-title-center">Choose what you need</h2>
      </div>
      <div class="home-entry">
        <ContentCard icon="search" title="Find data" href={`${base}/catalogue`} tint="teal" arrow>
          Search datasets by place, theme, source or readiness status.
        </ContentCard>
        <ContentCard icon="upload" title="Share data" href={`${base}/contribute`} tint="amber" arrow>
          Register a dataset so others can discover, cite or request access to it.
        </ContentCard>
        <ContentCard icon="map-pin" title="Use data for decisions" href={`${base}/landscapes`} tint="terracotta" arrow>
          Explore landscape evidence for planning, restoration, monitoring and research.
        </ContentCard>
      </div>
    </div>
  </section>

  <!-- ── Who is MOSAIC for? ────────────────────────────────────────────
       Kept open (no cards), but tighter and with plain teal glyphs: this
       section supports the entry points, it does not compete with them. -->
  <section class="section-white">
    <div class="container">
      <div class="section-head section-head--tight">
        <p class="section-eyebrow section-eyebrow--amber">Open to all</p>
        <h2 class="section-title-center">Who is MOSAIC for?</h2>
      </div>
      <ul class="who-grid">
        <li class="who-item"><Icon name="search" size={18} class="who-ico" aria-hidden="true" /><span><strong>Researchers</strong> looking for landscape datasets</span></li>
        <li class="who-item"><Icon name="upload" size={18} class="who-ico" aria-hidden="true" /><span><strong>Institutions</strong> sharing geospatial evidence</span></li>
        <li class="who-item"><Icon name="map-pin" size={18} class="who-ico" aria-hidden="true" /><span><strong>Landscape teams</strong> coordinating data across places</span></li>
        <li class="who-item"><Icon name="sparkles" size={18} class="who-ico" aria-hidden="true" /><span><strong>Decision-makers</strong> comparing environmental and social information</span></li>
        <li class="who-item"><Icon name="database" size={18} class="who-ico" aria-hidden="true" /><span><strong>Data stewards</strong> improving discoverability and reuse</span></li>
        <li class="who-item"><Icon name="users" size={18} class="who-ico" aria-hidden="true" /><span><strong>Funders and partners</strong> tracking evidence across initiatives</span></li>
      </ul>
    </div>
  </section>

  <!-- ── Featured datasets ─────────────────────────────────────────────
       Title leads; readiness keeps the colour marker, access level is
       plain text. No gradient bar — the card already has structure. -->
  <section class="section-subtle">
    <div class="container">
      <div class="section-header">
        <div class="section-header-text">
          <p class="section-eyebrow section-eyebrow--amber">Explore data</p>
          <h2>Featured datasets</h2>
          <p class="section-subtitle">Recently added and validated datasets from across the network.</p>
        </div>
        <a href={`${base}/catalogue`} class="section-link">Browse all {totalDatasets} datasets &rarr;</a>
      </div>
      <div class="cards-grid">
        {featured.map((d) => (
          <article class="dataset-card-new">
            <h3 class="dataset-card-title">{d.title}</h3>
            <p class="dataset-card-status">
              <StatusBadge status={d.readiness_status} />
              <span class="dataset-card-access">{d.access_level ?? 'Access not specified'}</span>
            </p>
            <dl class="dataset-card-meta">
              <div><dt>Country</dt><dd>{d.country}</dd></div>
              <div><dt>Theme</dt><dd>{d.mfl_theme}</dd></div>
            </dl>
            <a href={`${base}/catalogue/${d.id}`} class="dataset-card-link">View details &rarr;</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Closing CTA — grow the network ────────────────────────────────
       Title, one explanation and the button. The territorial context is
       already carried by the hero. -->
  <section class="grow-cta">
    <div class="container">
      <div class="grow-card">
        <div class="grow-main">
          <h2 class="grow-title">Help grow the MOSAIC network</h2>
          <p class="grow-body">
            Your dataset could help researchers, landscape teams and decision-makers
            across multiple countries.
          </p>
        </div>
        <a class="grow-btn" href={`${base}/contribute`}>
          Contribute a dataset
          <Icon name="arrow-right" size={18} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero (light) ──────────────────────────────────────────── */
  .hero {
    position: relative;
    background-color: var(--mosaic-sand);
    color: var(--mosaic-ink);
    padding: 4rem 0 4.5rem;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }
  .hero-content { max-width: 540px; }

  /* Contained in the page grid, not bled to the window edge. */
  .hero-art { min-width: 0; }
  .hero-art img {
    display: block;
    width: 100%;
    height: 340px;
    object-fit: cover;
    object-position: center;
    border-radius: var(--radius-md);
  }

  .hero-eyebrow {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mosaic-amber);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }
  /* The one Georgia heading on this page. */
  .hero-headline {
    font-family: var(--font-title);
    font-size: clamp(2.1rem, 3.6vw, 3rem);
    font-weight: 700;
    line-height: 1.12;
    color: var(--mosaic-ink);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }
  .hero-sub {
    font-size: var(--text-lg);
    /* Fixed grey (not a theming token) — this hero is always light in both
       themes, so the subtitle must stay dark-on-sand and never invert. */
    color: #4B5563;
    line-height: 1.6;
    max-width: 470px;
    margin-bottom: var(--space-3);
  }
  .hero-support {
    font-size: var(--text-base);
    color: #5B6B72;
    line-height: 1.6;
    max-width: 470px;
    margin: 0 0 var(--space-6);
  }
  .hero-actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .hero-actions .btn { display: inline-flex; align-items: center; gap: var(--space-2); }

  .btn-hero-primary {
    background-color: var(--mosaic-teal);
    color: var(--color-white);
    border-color: var(--mosaic-teal);
    font-weight: 600;
    padding: var(--space-3) var(--space-6);
  }
  .btn-hero-primary:hover { background-color: var(--mosaic-teal-dark); border-color: var(--mosaic-teal-dark); color: var(--color-white); }
  .btn-hero-ghost {
    /* Sits on the hero band, which stays light in BOTH themes — use the
       never-remapped white, not --color-surface (dark-on-dark in dark mode). */
    background-color: var(--color-white);
    color: var(--mosaic-teal);
    border: 2px solid var(--mosaic-teal);
    font-weight: 600;
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
    cursor: pointer;
  }
  .btn-hero-ghost:hover { background-color: var(--mosaic-teal); color: var(--color-white); }

  /* ── Figures bar ───────────────────────────────────────────── */
  .stats-section {
    background-color: var(--color-bg);
    padding: var(--space-8) 0 var(--space-12);
  }
  .stats-bar {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
  }
  .stat-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: 1 1 0;
    min-width: 0;
  }
  /* Uniform Ocean Teal glyphs — no tinted circles. */
  .stat-item :global(.stat-icon) {
    flex-shrink: 0;
    color: var(--mosaic-teal);
  }
  /* Ocean Teal disappears on the dark surfaces — use the reverse brand tone. */
  :global([data-theme='dark']) .stat-item :global(.stat-icon) { color: var(--mosaic-light-teal); }
  .stat-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  /* Figures are data, not editorial headings → Calibri. */
  .stat-number {
    font-family: var(--font-body);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }
  .stat-label { font-size: var(--text-sm); color: var(--color-muted); font-weight: 400; }
  .stat-divider { width: 1px; align-self: stretch; background-color: var(--color-border); flex-shrink: 0; margin: var(--space-1) 0; }

  /* ── Sections ──────────────────────────────────────────────── */
  .section-white { background-color: var(--color-bg); padding: var(--space-12) 0; }
  .section-subtle { background-color: var(--color-gray-50); padding: var(--space-16) 0; }

  /* Section headings are UI, not editorial copy → Calibri Bold. */
  .section-title-center,
  .section-header h2,
  .grow-title {
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0;
  }
  .section-title-center { text-align: center; font-size: 1.7rem; margin-bottom: var(--space-10); }

  /* Centred section head: eyebrow + title. No decorative wave underneath —
     it carried no information and was not tied to the MOSAIC mark. */
  .section-head { text-align: center; margin-bottom: var(--space-10); }
  .section-head .section-title-center { margin-bottom: 0; }
  .section-head--tight { margin-bottom: var(--space-8); }
  .section-eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6F8F5F;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    gap: var(--space-4);
  }
  .section-header h2 { margin: 0; font-size: 1.7rem; }
  .section-header-text { display: flex; flex-direction: column; }
  .section-header .section-eyebrow { margin-bottom: var(--space-2); }
  .section-eyebrow--amber { color: var(--mosaic-amber); }
  .section-subtitle {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font-size: var(--text-base);
    max-width: 60ch;
  }
  .section-link { font-size: var(--text-sm); font-weight: 600; color: var(--mosaic-teal); text-decoration: none; white-space: nowrap; }

  .home-entry { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }

  /* ── "Who is MOSAIC for?" audience grid ─────────────────────── */
  .who-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4) var(--space-8);
  }
  .who-item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .who-item strong { font-weight: 700; }
  .who-item :global(.who-ico) {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--mosaic-teal);
  }
  :global([data-theme='dark']) .who-item :global(.who-ico) { color: var(--mosaic-light-teal); }
  @media (max-width: 900px) { .who-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .who-grid { grid-template-columns: 1fr; } }

  /* ── Entry cards ───────────────────────────────────────────────
     Plain cards: discreet radius, hairline border, no corner contour
     texture and no lift shadow. Scoped to .home-entry so other
     ContentCard uses are untouched. */
  .home-entry :global(.content-card) {
    border-radius: var(--radius-md);
    box-shadow: none;
  }
  .home-entry :global(.content-card--link:hover),
  .home-entry :global(.content-card--link:focus-visible) {
    transform: none;
    box-shadow: none;
    border-color: var(--mosaic-teal);
  }
  /* Card titles are not editorial headings → Calibri Bold. */
  .home-entry :global(.content-card-title) {
    font-family: var(--font-body);
    font-weight: 700;
  }

  /* ── Dataset cards ─────────────────────────────────────────── */
  .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-6); }
  .dataset-card-new {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color 0.15s;
  }
  .dataset-card-new:hover { border-color: var(--mosaic-teal); }
  .dataset-card-title {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
    margin: 0;
  }
  /* Readiness keeps the colour marker; access level is plain text. */
  .dataset-card-status {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
  }
  .dataset-card-access { font-size: var(--text-sm); color: var(--color-muted); }
  .dataset-card-meta { display: flex; flex-direction: column; gap: var(--space-1); margin: var(--space-1) 0 0; }
  .dataset-card-meta div { display: flex; gap: var(--space-2); font-size: var(--text-sm); }
  .dataset-card-meta dt { color: var(--color-muted); font-weight: 500; min-width: 56px; }
  .dataset-card-meta dd { color: var(--color-text); margin: 0; }
  .dataset-card-link { margin-top: auto; padding-top: var(--space-2); font-size: var(--text-sm); font-weight: 600; color: var(--mosaic-teal); text-decoration: none; }

  /* ── Closing CTA — grow the network ────────────────────────── */
  .grow-cta {
    background-color: var(--color-surface);
    padding: var(--space-12) 0;
  }
  .grow-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
    background-color: var(--mosaic-sand);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
  }
  .grow-main { flex: 1; min-width: 280px; }
  .grow-title { margin: 0 0 var(--space-2); font-size: 1.5rem; color: var(--mosaic-ink); }
  .grow-body { margin: 0; color: #4B5563; max-width: 58ch; line-height: 1.6; }

  .grow-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--mosaic-teal);
    color: var(--color-white);
    font-weight: 600;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background-color 0.15s;
    white-space: nowrap;
  }
  .grow-btn:hover { background-color: var(--mosaic-teal-dark); color: var(--color-white); }

  @media (max-width: 900px) {
    .grow-card { padding: var(--space-6); }
    .grow-btn { width: 100%; justify-content: center; }
  }

  /* ── Responsive ────────────────────────────────────────────── */
  @media (max-width: 992px) {
    .hero-inner { gap: var(--space-8); }
    .hero-content { max-width: 460px; }
    .hero-art img { height: 300px; }
  }
  @media (max-width: 900px) {
    .home-entry { grid-template-columns: 1fr; }
    .stats-bar { flex-wrap: wrap; }
    .stat-item { flex: 1 1 40%; }
    .stat-divider { display: none; }
  }
  @media (max-width: 767px) {
    .hero { padding: 3rem 0 3.5rem; }
    .hero-inner { grid-template-columns: 1fr; }
    .hero-content { max-width: none; }
    .hero-art img { height: 220px; }
  }
  @media (max-width: 640px) {
    .stat-item { flex: 1 1 100%; }
    .stat-number { font-size: 1.5rem; }
    .stats-bar { padding: var(--space-5); gap: var(--space-5); }
  }
</style>
