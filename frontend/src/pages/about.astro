---
/* About — one page for everything about MOSAIC and how to take part (2026-11-09):
   the former About, Contact, Contribute and Metadata Guide pages, as sections
   behind a side menu. Clicking a menu item shows that section (no reload); the
   address keeps the section (#contribute, #metadata, …) so it can be linked.
   Without JavaScript every section is shown, one after another. Old addresses
   redirect here: /contact → #contact, /contribute → #contribute,
   /contribute/metadata-guide → #metadata. */
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/ui/PageHero.astro'
import Icon from '../components/ui/Icon.astro'
import Overview from '../components/about/Overview.astro'
import HowToContribute from '../components/about/HowToContribute.astro'
import MetadataGuide from '../components/about/MetadataGuide.astro'
import Faq from '../components/about/Faq.astro'
import GetInTouch from '../components/about/GetInTouch.astro'
import Acknowledgements from '../components/about/Acknowledgements.astro'

const sections = [
  { id: 'overview', label: 'Overview', icon: 'globe', title: 'What MOSAIC is' },
  { id: 'contribute', label: 'How to contribute', icon: 'upload', title: 'How to contribute' },
  { id: 'metadata', label: 'Metadata guide', icon: 'file-text', title: 'Metadata guide' },
  { id: 'faq', label: 'FAQ', icon: 'help-circle', title: 'Frequently asked questions' },
  { id: 'contact', label: 'Get in touch', icon: 'mail', title: 'Get in touch' },
  { id: 'acknowledgements', label: 'Acknowledgements', icon: 'building', title: 'Acknowledgements' },
] as const
---

<BaseLayout title="About" description="About MOSAIC — what it is, who it serves, how to contribute a dataset, the metadata guide and how to get in touch.">
  <PageHero
    variant="light"
    compact
    contours
    title="About MOSAIC"
    subtitle="An open geospatial data network for living landscapes, with support from the CGIAR Multifunctional Landscapes Science Programme."
  />

  <div class="container ab" data-ab>
    <nav class="ab-nav" aria-label="About sections">
      <ul>
        {sections.map((s, i) => (
          <li>
            <a href={`#${s.id}`} data-tab={s.id} aria-current={i === 0 ? 'true' : undefined}>
              <Icon name={s.icon} size={18} />
              <span>{s.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ab-main">
      {sections.map((s, i) => (
        <section class="ab-sec" id={s.id} data-section={s.id} aria-labelledby={`${s.id}-title`}>
          <h2 class="ab-h2" id={`${s.id}-title`} tabindex="-1">
            {s.title}<svg class="wavy" width="64" height="8" viewBox="0 0 64 8" fill="none" aria-hidden="true"><path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" /></svg>
          </h2>
          {s.id === 'overview' && <Overview />}
          {s.id === 'contribute' && <HowToContribute />}
          {s.id === 'metadata' && <MetadataGuide />}
          {s.id === 'faq' && <Faq />}
          {s.id === 'contact' && <GetInTouch />}
          {s.id === 'acknowledgements' && <Acknowledgements />}
          {sections[i + 1] && (
            <a class="ab-next" href={`#${sections[i + 1].id}`}>
              Next: {sections[i + 1].label} <Icon name="arrow-right" size={16} />
            </a>
          )}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .ab {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  /* side menu */
  .ab-nav { position: sticky; top: calc(var(--space-16) + var(--space-4)); }
  .ab-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .ab-nav a {
    position: relative;
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    color: var(--color-muted); font-weight: 600; text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .ab-nav a:hover { background: var(--color-surface); color: var(--color-text); }
  .ab-nav a:focus-visible { outline: 2px solid var(--mosaic-teal); outline-offset: 2px; }
  .ab-nav a[aria-current='true'] { background: var(--mosaic-light-teal); color: var(--mosaic-teal); }
  .ab-nav a[aria-current='true']::before {
    content: ''; position: absolute; left: 0; top: 20%; bottom: 20%; width: 3px;
    border-radius: var(--radius-full); background: var(--mosaic-teal);
  }
  :global([data-theme='dark']) .ab-nav a[aria-current='true'] { background: rgba(214, 238, 242, 0.12); color: var(--mosaic-light-teal); }
  :global([data-theme='dark']) .ab-nav a[aria-current='true']::before { background: var(--mosaic-light-teal); }

  /* sections */
  /* clears the sticky site header (and the chip row on phones) when arriving via #section */
  .ab-sec { scroll-margin-top: 7rem; }
  .ab-sec + .ab-sec { margin-top: var(--space-16); }
  /* With JavaScript, only the chosen section is shown */
  .ab.is-tabs .ab-sec + .ab-sec { margin-top: 0; }
  .ab.is-tabs .ab-sec:not(.is-on) { display: none; }
  .ab.is-tabs .ab-sec.is-on { animation: ab-in 0.35s ease; }
  @keyframes ab-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  .ab-h2 { display: flex; flex-direction: column; gap: var(--space-2); margin: 0 0 var(--space-6); outline: none; }
  .wavy { color: var(--mosaic-teal); }

  .ab-next {
    display: inline-flex; align-items: center; gap: var(--space-2);
    margin-top: var(--space-12); padding-top: var(--space-6);
    border-top: 1px solid var(--color-border); width: 100%;
    color: var(--mosaic-teal); font-weight: 600; text-decoration: none;
  }
  .ab-next:hover { text-decoration: underline; }
  :global([data-theme='dark']) .ab-next { color: var(--mosaic-light-teal); }
  .ab:not(.is-tabs) .ab-next { display: none; }

  @media (max-width: 900px) {
    .ab { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); padding-top: var(--space-6); }
    /* the menu becomes a row of chips that stays under the header */
    .ab-nav {
      top: var(--space-16); z-index: 5; margin: 0 calc(-1 * var(--space-4));
      padding: var(--space-2) var(--space-4); background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
    }
    .ab-nav ul { flex-direction: row; overflow-x: auto; gap: var(--space-2); scrollbar-width: none; }
    .ab-nav a { white-space: nowrap; padding: var(--space-2) var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-full); }
    .ab-nav a[aria-current='true']::before { display: none; }
    .ab-sec { scroll-margin-top: 9.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ab.is-tabs .ab-sec.is-on { animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-ab]')
  if (root) {
    const secs = Array.from(root.querySelectorAll<HTMLElement>('[data-section]'))
    const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-tab]'))
    const ids = secs.map((s) => s.dataset.section!)
    // old in-page anchors that now live in another section
    const alias: Record<string, string> = { 'how-it-works': 'contribute', 'metadata-guide': 'metadata' }
    const resolve = (hash: string) => {
      const h = decodeURIComponent(hash.replace(/^#/, ''))
      const id = alias[h] ?? h
      return ids.includes(id) ? id : null
    }

    function show(id: string, opts: { focus?: boolean; scroll?: boolean } = {}) {
      secs.forEach((s) => s.classList.toggle('is-on', s.dataset.section === id))
      tabs.forEach((t) => {
        if (t.dataset.tab === id) t.setAttribute('aria-current', 'true')
        else t.removeAttribute('aria-current')
      })
      // keep the active chip visible in the mobile row
      const active = tabs.find((t) => t.dataset.tab === id)
      const ul = active?.closest('ul')
      if (active && ul && ul.scrollWidth > ul.clientWidth) {
        ul.scrollTo({ left: active.offsetLeft - 16, behavior: 'smooth' })
      }
      if (opts.scroll) {
        // bring the top of the content into view if the reader had scrolled down
        const top = root!.getBoundingClientRect().top + window.scrollY - (window.innerWidth <= 900 ? 72 : 112)
        if (window.scrollY > top) window.scrollTo({ top, behavior: 'smooth' })
      }
      if (opts.focus) root!.querySelector<HTMLElement>(`#${id}-title`)?.focus({ preventScroll: true })
    }

    root.classList.add('is-tabs')
    // arriving at /about#section: the browser scrolls to the section itself
    show(resolve(location.hash) ?? 'overview')

    // Any in-page link to a section (menu, "Next", links inside the content)
    root.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]')
      if (!a) return
      const id = resolve(a.getAttribute('href')!)
      if (!id) return
      e.preventDefault()
      history.pushState(null, '', `#${id}`)
      show(id, { focus: true, scroll: true })
    })
    window.addEventListener('popstate', () => show(resolve(location.hash) ?? 'overview', { scroll: true }))
    window.addEventListener('hashchange', () => { const id = resolve(location.hash); if (id) show(id, { scroll: true }) })
  }
</script>
