---
import { existsSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/ui/PageHero.astro'
import ContentCard from '../components/ui/ContentCard.astro'
import CoordinatorCard from '../components/ui/CoordinatorCard.astro'

const base = import.meta.env.BASE_URL

/* Get in touch — merged here from the former Contact page (2026-11-09);
   /contact now redirects to /about#contact. */
const ghBase = 'https://github.com/MOSAIC-mfl/website/issues/new'
// Dataset records live in the catalog repo — dataset corrections go there.
const catalogIssueUrl = 'https://github.com/MOSAIC-mfl/catalog/issues/new'
const siteUrl = 'https://mosaic-mfl.github.io/website/'

// Show the photo only if the file is actually present; otherwise CoordinatorCard
// renders the "LL" initials fallback.
const hasPhoto = existsSync(fileURLToPath(new URL('../../public/illustrations/lizeth-llanos.jpg', import.meta.url)))

const issueCards = [
  { icon: 'alert-circle', title: 'Report a problem', tint: 'teal', href: `${ghBase}?template=bug_report.yml`, body: 'A broken page or data that looks wrong.' },
  { icon: 'file-text', title: 'Correct a dataset', tint: 'amber', href: catalogIssueUrl, body: 'Update or fix the information in a catalogue entry.' },
  { icon: 'file', title: 'Fix content', tint: 'light-teal', href: `${ghBase}?template=content_fix.yml`, body: 'Improve a guide, description or other site text.' },
  { icon: 'sparkles', title: 'Suggest an idea', tint: 'terracotta', href: `${ghBase}?template=feature_request.yml`, body: 'Propose a new feature or improvement.' },
] as const

const contactRows = [
  // Email intentionally a clearly-marked placeholder — do not invent an address.
  { icon: 'mail', label: 'Email', value: 'Contact email — to be confirmed' },
  { icon: 'globe', label: 'Website', value: 'mosaic-mfl.github.io/website', href: siteUrl },
]

/* Acknowledgements — official CGIAR / Science Programme lockups, used as supplied
   and always on a white plate so they show in CGIAR's own colours in both themes
   (MOSAIC Brand Guidelines v1.0, §5 — never recoloured or recreated). The images
   are decorative: each card's heading already names the institution. */
const acknowledgements = [
  {
    logo: 'cgiar-logo-full.png',
    width: 600,
    height: 269,
    title: 'CGIAR',
    text: 'MOSAIC is developed within CGIAR, the global research partnership for a food-secure future. This work is carried out with support from the CGIAR Trust Fund and the funders who contribute to it.',
  },
  {
    logo: 'cgiar-mfl-lockup.png',
    width: 2048,
    height: 687,
    title: 'Multifunctional Landscapes Science Programme',
    text: 'The CGIAR Multifunctional Landscapes (MFL) Science Programme hosts and funds MOSAIC, under its work on landscape optimization and inclusive planning, and through the MFL Geospatial Community of Practice that maintains the catalogue.',
  },
  {
    logo: 'cgiar-climate-action-lockup.png',
    width: 600,
    height: 288,
    title: 'Climate Action Science Programme',
    text: 'We acknowledge the CGIAR Climate Action Science Programme and the collaboration on shared metadata standards with the CGIAR Climate Data Hub, which keeps climate layers discoverable through MOSAIC while they remain maintained at their source.',
  },
] as const

---

<BaseLayout title="About" description="About MOSAIC — what it is, who it serves and how to get in touch.">
  <PageHero
    variant="light"
    compact
    contours
    title="About MOSAIC"
    subtitle="An open geospatial data network for living landscapes, with support from the CGIAR Multifunctional Landscapes Science Programme."
  />

  <div class="container about-body">

    <!-- What MOSAIC is -->
    <section class="about-split">
      <div class="about-split-text">
        <h2 class="about-h2">What MOSAIC is<svg class="wavy" width="64" height="8" viewBox="0 0 64 8" fill="none" aria-hidden="true"><path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg></h2>
        <p>
          MOSAIC is a catalogue and set of connectors that show what geospatial data exists for living
          landscapes, who produced it, at what resolution and time period, and how to access it. Its
          guiding principle is to connect, not duplicate: it links the global data services the world
          already maintains with the local datasets only CGIAR holds.
        </p>
        <p>
          Data files stay with the institution that produced them and are linked from each catalogue
          entry. Every entry carries a readiness status, from first registration through to
          analytics-ready.
        </p>
      </div>
      <div class="about-split-art" aria-hidden="true">
        <img src={`${base}/illustrations/network-diagram.png`} alt="" />
      </div>
    </section>

    <!-- Who it serves -->
    <section class="about-serves">
      <h2 class="about-h2">Who it serves<svg class="wavy" width="64" height="8" viewBox="0 0 64 8" fill="none" aria-hidden="true"><path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg></h2>
      <p class="about-lead">Anyone working with data for living landscapes — research institutions, universities, public agencies, NGOs, landscape initiatives and independent researchers.</p>
      <div class="about-cards">
        <ContentCard icon="users" title="Data users" tint="teal">
          Researchers, GIS analysts, decision-makers and landscape teams who need to know what data
          exists for a landscape and how to get it.
        </ContentCard>
        <ContentCard icon="upload" title="Data contributors" tint="amber">
          Data stewards and focal points who want their datasets to be findable, documented and
          reusable. <a href={`${base}/contribute`}>How to contribute &rarr;</a>
        </ContentCard>
      </div>
    </section>

    <!-- Get in touch (formerly the Contact page) -->
    <section class="about-contact" id="contact">
      <h2 class="about-h2">Get in touch<svg class="wavy" width="64" height="8" viewBox="0 0 64 8" fill="none" aria-hidden="true"><path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg></h2>
      <p class="about-lead">The fastest way to reach the team is a GitHub issue — pick the one that fits:</p>
      <div class="contact-cards">
        {issueCards.map((c) => (
          <ContentCard icon={c.icon} title={c.title} tint={c.tint} href={c.href} target="_blank" arrow>
            {c.body}
          </ContentCard>
        ))}
      </div>
      <p class="about-lead contact-direct-lead">For anything else, contact the MOSAIC coordinator:</p>
      <div class="contact-direct">
        <CoordinatorCard
          name="Lizeth Llanos"
          role="MFL Geospatial Coordinator"
          orgLines={["Alliance of Bioversity International and CIAT", "CGIAR MFL Science Programme"]}
          photo={hasPhoto ? `${base}/illustrations/lizeth-llanos.jpg` : undefined}
          rows={contactRows}
        />
      </div>
    </section>

    <!-- Acknowledgements -->
    <section class="about-ack" id="acknowledgements">
      <h2 class="about-h2">Acknowledgements<svg class="wavy" width="64" height="8" viewBox="0 0 64 8" fill="none" aria-hidden="true"><path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg></h2>
      <p class="about-lead">
        MOSAIC is a collective effort. We gratefully acknowledge the institutions and science
        programmes that make this work possible.
      </p>
      <div class="ack-cards">
        {acknowledgements.map((a) => (
          <div class="ack-card">
            <div class="ack-logo">
              <img src={`${base}/${a.logo}`} alt="" width={a.width} height={a.height} aria-hidden="true" />
            </div>
            <h3 class="ack-title">{a.title}</h3>
            <p class="ack-text">{a.text}</p>
          </div>
        ))}
      </div>
      <p class="about-ack-note">
        For the full list of CGIAR funders, see <a href="https://www.cgiar.org/funders/" target="_blank" rel="noopener noreferrer">cgiar.org/funders</a>.
      </p>
    </section>

  </div>
</BaseLayout>

<style>
  .about-body {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .about-h2 {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
  }
  .wavy { color: var(--mosaic-teal); }

  /* What MOSAIC is */
  .about-split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-8);
    align-items: center;
  }
  .about-split-text p { color: var(--color-muted); line-height: 1.7; margin: 0 0 var(--space-4); }
  .about-split-text p:last-child { margin-bottom: 0; }
  .about-split-art img { display: block; width: 100%; height: auto; }

  /* Who it serves */
  .about-lead { color: var(--color-muted); margin: 0 0 var(--space-6); max-width: 60ch; }
  .about-cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); }

  /* Get in touch */
  .about-contact { scroll-margin-top: var(--space-16); }
  .contact-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  .contact-direct-lead { margin-top: var(--space-8); margin-bottom: var(--space-4); }
  .contact-direct { max-width: 640px; }

  /* Acknowledgements */
  .ack-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }

  .ack-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  /* White plate for the official lockups — stays white in dark mode (as in the
     footer endorsement), because --color-white is deliberately not remapped. */
  .ack-logo {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    min-height: 104px;
  }
  /* Sized by width so the three horizontal lockups read at a comparable optical
     weight, with a height cap for the taller (two-square) ones. */
  .ack-logo img { display: block; width: auto; height: auto; max-width: 160px; max-height: 72px; object-fit: contain; }

  .ack-title {
    margin: 0;
    font-size: var(--text-lg);
    font-family: var(--font-title);
    color: var(--color-text);
    line-height: 1.3;
  }
  .ack-text { margin: 0; font-size: var(--text-sm); color: var(--color-muted); line-height: 1.6; }

  .about-ack-note { color: var(--color-muted); font-size: var(--text-sm); margin: var(--space-6) 0 0; }
  .about-ack-note a { color: var(--mosaic-teal); }
  /* Ocean Teal is too dark to read on the dark surface — use the light tint of
     the same brand colour there (the accent itself is never restyled). */
  :global([data-theme="dark"]) .about-ack-note a { color: var(--mosaic-light-teal); }

  @media (max-width: 1023px) {
    .ack-cards, .contact-cards { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 767px) {
    .ack-cards { grid-template-columns: 1fr; }
    .about-split, .about-cards { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .contact-cards { grid-template-columns: 1fr; }
  }
</style>
