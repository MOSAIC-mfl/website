---
/* Page not found. Astro builds this file as /404.html, and GitHub Pages serves
   it for any address under /website/ that does not exist — instead of GitHub's
   own "Page not found", which offered no way back to the site. */
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/ui/Icon.astro'

const base = import.meta.env.BASE_URL

const ways = [
  { href: `${base}/landscapes`, icon: 'map-pin', title: 'Landscapes', text: 'See the living landscapes on a map and what exists for each one.' },
  { href: `${base}/catalogue`, icon: 'search', title: 'Catalogue', text: 'Search the datasets registered so far.' },
  { href: `${base}/about`, icon: 'globe', title: 'About', text: 'What MOSAIC is, how to contribute and how to get in touch.' },
] as const
---

<BaseLayout title="Page not found" description="This address does not exist on the MOSAIC site. Start again from Landscapes, the Catalogue or About.">
  <div class="container nf">
    <p class="nf-tag">Error 404</p>
    <h1 class="nf-title">Page not found</h1>
    <p class="nf-text">
      There is nothing at this address. The page may have moved, or the link may be mistyped.
      These will get you back on track:
    </p>

    <ul class="nf-ways">
      {ways.map((w) => (
        <li>
          <a class="nf-way" href={w.href}>
            <span class="nf-ico" aria-hidden="true"><Icon name={w.icon} size={22} /></span>
            <span class="nf-way-text">
              <strong>{w.title}</strong>
              <span>{w.text}</span>
            </span>
            <span class="nf-arrow" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
          </a>
        </li>
      ))}
    </ul>

    <p class="nf-home"><a href={`${base}/`}>Back to the home page</a></p>
  </div>
</BaseLayout>

<style>
  .nf {
    max-width: 720px;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }
  .nf-tag {
    display: inline-block; margin: 0 0 var(--space-3); padding: 0.1rem var(--space-3);
    border-radius: var(--radius-full); background: var(--color-gray-100); color: var(--color-muted);
    font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .nf-title { margin: 0 0 var(--space-4); }
  .nf-text { color: var(--color-muted); line-height: 1.7; margin: 0 0 var(--space-8); max-width: 60ch; }

  .nf-ways { list-style: none; margin: 0 0 var(--space-8); padding: 0; display: grid; gap: var(--space-3); }
  .nf-way {
    display: flex; align-items: center; gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text); text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .nf-way:hover { border-color: var(--mosaic-teal); box-shadow: var(--shadow-card); color: var(--color-text); }
  .nf-ico {
    flex-shrink: 0; width: 44px; height: 44px; border-radius: var(--radius-full);
    display: inline-flex; align-items: center; justify-content: center;
    background-color: var(--color-gray-100); color: var(--color-gray-700);
  }
  .nf-way-text { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
  .nf-way-text strong { font-family: var(--font-title); font-size: var(--text-lg); color: var(--color-text); }
  .nf-way-text span { color: var(--color-muted); font-size: var(--text-sm); line-height: 1.5; }
  .nf-arrow { flex-shrink: 0; display: inline-flex; color: var(--color-muted); }

  .nf-home { margin: 0; font-size: var(--text-sm); }
  /* Ocean Teal is too dark to read on the dark background: light tint there */
  :global([data-theme='dark']) .nf-way:hover { border-color: var(--mosaic-light-teal); }
</style>
