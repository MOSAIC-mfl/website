---
import BaseLayout from '../../layouts/BaseLayout.astro'
import StatusBadge from '../../components/ui/StatusBadge.astro'
import AccessBadge from '../../components/ui/AccessBadge.astro'
import Breadcrumb from '../../components/ui/Breadcrumb.astro'
import Icon from '../../components/ui/Icon.astro'
import landscapes from '../../../data/landscapes.json'
import { loadDatasets } from '../../utils/loadDatasets'
import { isSpdxLicense } from '../../utils/license'
import { READINESS_MEANING, READINESS_NOTE, READINESS_ORDER } from '../../utils/readiness'

export async function getStaticPaths() {
  const datasets = await loadDatasets()
  return datasets.map((d) => ({
    params: { id: d.id },
    props: { dataset: d },
  }))
}

const { dataset } = Astro.props
const base = import.meta.env.BASE_URL

// An SPDX id reads as a license name; any other value is the source's own
// wording, shown verbatim as its terms of use.
const spdxLicense = isSpdxLicense(dataset.license)

// A citation is shown only when the record carries one. The one that used to
// be generated here put the period the data covers where the year of
// publication goes and the registering organisation where the author goes, so
// it was wrong for most records. Without one, the page says how to cite and
// gives a reference to the catalogue record itself.
const citation = dataset.citation?.trim() || null
const recordUrl = new URL(`${base}/catalogue/${dataset.id}/`, Astro.site).href

// Related datasets: same landscape and/or theme, best matches first, excluding self.
const allDatasets = await loadDatasets()
const related = allDatasets
  .filter((d) => d.id !== dataset.id &&
    (d.living_landscape === dataset.living_landscape ||
      (!!dataset.mfl_theme && d.mfl_theme === dataset.mfl_theme)))
  .map((d) => ({
    d,
    score: (d.living_landscape === dataset.living_landscape ? 2 : 0) +
      (!!dataset.mfl_theme && d.mfl_theme === dataset.mfl_theme ? 1 : 0),
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map((x) => x.d)


// ── Page structure (2026-11-12) ─────────────────────────────────────────
// Header (what it is, who it is from, where it belongs, what you can do),
// then four sections a visitor can jump to, and a side column of quick facts.
const hasLandscapePage = landscapes.some((l) => l.code === dataset.living_landscape)
const landscapeLabel = dataset.landscape_name ?? dataset.living_landscape
const coverageLabel =
  dataset.coverage === 'global' ? 'Global'
    : dataset.coverage === 'national' ? `${dataset.country ?? landscapeLabel} (national)`
      : landscapeLabel
const resolution = dataset.spatial_resolution && dataset.spatial_resolution !== 'N/A' ? dataset.spatial_resolution : null
const formats = dataset.formats ?? []
const tags = [dataset.mfl_theme, dataset.data_type, dataset.country].filter(Boolean) as string[]

// Corrections go to the catalog's issue tracker, with the record named in the title.
const issueBase = 'https://github.com/MOSAIC-mfl/catalog/issues/new'
const editUrl = `${issueBase}?title=${encodeURIComponent(`${dataset.id}: suggested edit`)}`
const problemUrl = `${issueBase}?title=${encodeURIComponent(`${dataset.id}: problem with this record`)}`

const sections = [
  { id: 'overview', label: 'Overview' },
  { id: 'access', label: 'Access & use' },
  { id: 'technical', label: 'Technical metadata' },
  { id: 'citation', label: 'Citation & contacts' },
]
const quickFacts = [
  ['Coverage', coverageLabel],
  ['Resolution', resolution],
  ['Temporal', dataset.temporal_coverage],
  ['Data type', dataset.data_type],
  ['Theme', dataset.mfl_theme],
].filter(([, v]) => v) as [string, string][]
---

<BaseLayout title={dataset.title} description={dataset.description ?? undefined}>
  <div class="container dp">

    <Breadcrumb crumbs={[
      { label: 'Home', href: `${base}/` },
      { label: 'Catalogue', href: `${base}/catalogue` },
      { label: dataset.title },
    ]} />

    <!-- Header: what it is, who it is from, where it belongs, what you can do -->
    <header class="dp-head">
      <h1 class="dp-title">{dataset.title}</h1>
      {dataset.source && <p class="dp-by">{dataset.source}</p>}
      <p class="dp-part">
        Part of:{' '}
        {hasLandscapePage
          ? <a href={`${base}/landscapes#${dataset.living_landscape}`}>{landscapeLabel}</a>
          : <span>{landscapeLabel}</span>}
        {dataset.country && dataset.coverage !== 'global' && <span class="dp-part-country"> · {dataset.country}</span>}
      </p>
      <dl class="dp-meta">
        <div><dt>Record</dt><dd>{dataset.id}</dd></div>
        <div><dt>License</dt><dd>{dataset.license ? (spdxLicense ? dataset.license : 'Terms at the source') : 'Not specified'}</dd></div>
        <div><dt>Readiness</dt><dd><StatusBadge status={dataset.readiness_status} /></dd></div>
        <div><dt>Access</dt><dd><AccessBadge access={dataset.access_level} /></dd></div>
      </dl>
      <div class="dp-actions">
        <a class="btn btn-primary" href="#access"><Icon name="download" size={18} /> Access the data</a>
        {dataset.metadata_url && (
          <a class="btn btn-secondary" href={dataset.metadata_url} target="_blank" rel="noopener noreferrer">Metadata (STAC JSON)</a>
        )}
        <a class="dp-action-link" href={editUrl} target="_blank" rel="noopener noreferrer">Suggest an edit ↗</a>
        <a class="dp-action-link" href={problemUrl} target="_blank" rel="noopener noreferrer">Report a problem ↗</a>
      </div>
    </header>

    <!-- Section tabs: one section is shown at a time. They are plain links to
         the sections, so without JavaScript the page shows all four in a row. -->
    <nav class="dp-nav" aria-label="Sections of this record">
      <ul>
        {sections.map((sec, i) => (
          <li><a href={`#${sec.id}`} data-tab={sec.id} aria-current={i === 0 ? 'true' : undefined}>{sec.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="dp-layout">
      <div class="dp-main">

        <!-- Overview -->
        <section id="overview" class="dp-sec">
          <h2>Overview</h2>
          {dataset.description
            ? <p class="dp-desc">{dataset.description}</p>
            : <p class="dp-muted">No description has been registered for this dataset yet.</p>}
          {tags.length > 0 && (
            <ul class="dp-tags" aria-label="Keywords">
              {tags.map((t) => <li>{t}</li>)}
            </ul>
          )}

          <div class="dp-note">
            <h3>Readiness: {dataset.readiness_status}</h3>
            <p>{READINESS_MEANING[dataset.readiness_status]} {READINESS_NOTE}</p>
            <details>
              <summary>What the three statuses mean</summary>
              <ul>
                {READINESS_ORDER.map((st) => (
                  <li><span class={`badge badge-${st.toLowerCase()}`}>{st}</span> {READINESS_MEANING[st]}</li>
                ))}
              </ul>
            </details>
          </div>
        </section>

        <!-- Access & use -->
        <section id="access" class="dp-sec">
          <h2>Access &amp; use</h2>
          <div class="ds-access">
            {dataset.access_level === 'Open' ? (
              <div>
                <p>
                  This dataset is openly available{spdxLicense ? ` under the ${dataset.license} license` : ''}.
                  MOSAIC connects to the source rather than re-hosting the data.
                </p>
                {dataset.license && !spdxLicense && (
                  <p><strong>Terms of use at the source:</strong> {dataset.license}</p>
                )}
                {dataset.download_url
                  ? <a href={dataset.download_url} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Go to source ↗</a>
                  : <p>No direct source link has been registered yet. See the contact below or the metadata record.</p>}
              </div>
            ) : dataset.access_level === 'Restricted' ? (
              <div>
                <p>Access to this dataset is restricted. To request access, please contact the data steward.</p>
                {dataset.license && !spdxLicense && (
                  <p><strong>Terms:</strong> {dataset.license}</p>
                )}
                {dataset.contact
                  ? <a class="btn btn-primary" href={`mailto:${dataset.contact}?subject=${encodeURIComponent(`MOSAIC ${dataset.id} — access request`)}`}>Request access by email</a>
                  : <p>No steward contact is registered yet. Contact the MOSAIC coordination team.</p>}
              </div>
            ) : dataset.access_level === 'Internal' ? (
              <div>
                <p>This dataset is for internal CGIAR use only. Contact the MOSAIC team if you believe you should have access.</p>
              </div>
            ) : (
              <div>
                <p>The access level for this dataset has not been specified yet. Contact the data steward or the MOSAIC coordination team for details.</p>
              </div>
            )}

            {dataset.gee_asset_id && (
              <div class="ds-access-gee">
                <p><strong>Google Earth Engine asset</strong></p>
                <p><code>{dataset.gee_asset_id}</code></p>
                <p class="dp-small">
                  An asset identifier, not a download link. The asset is not public yet &mdash; opening it
                  in Earth Engine needs an Earth Engine account and access granted by the MOSAIC
                  coordination team.
                </p>
              </div>
            )}
          </div>
          <dl class="dp-kv">
            <div><dt>Access level</dt><dd>{dataset.access_level ?? 'Not specified'}</dd></div>
            <div><dt>License</dt><dd>{dataset.license ?? 'Not specified'}</dd></div>
            {formats.length > 0 && <div><dt>Formats</dt><dd>{formats.join(', ')}</dd></div>}
            {dataset.download_url && (
              <div><dt>Source address</dt><dd><a href={dataset.download_url} target="_blank" rel="noopener noreferrer">{dataset.download_url}</a></dd></div>
            )}
          </dl>
        </section>

        <!-- Technical metadata -->
        <section id="technical" class="dp-sec">
          <h2>Technical metadata</h2>
          <p class="dp-muted">The spatial, temporal and file detail behind the summaries on this page.</p>
          <h3>Spatial</h3>
          <dl class="dp-kv">
            <div><dt>Coverage</dt><dd>{coverageLabel}</dd></div>
            <div><dt>Living landscape</dt><dd>{landscapeLabel} <code>{dataset.living_landscape}</code></dd></div>
            <div><dt>Country</dt><dd>{dataset.country ?? 'Not specified'}</dd></div>
            <div><dt>Spatial resolution</dt><dd>{resolution ?? 'Not specified'}</dd></div>
          </dl>
          <h3>Temporal</h3>
          <dl class="dp-kv">
            <div><dt>Period covered</dt><dd>{dataset.temporal_coverage ?? 'Not specified'}</dd></div>
          </dl>
          <h3>Data</h3>
          <dl class="dp-kv">
            <div><dt>Data type</dt><dd>{dataset.data_type ?? 'Not specified'}</dd></div>
            <div><dt>Formats</dt><dd>{formats.length > 0 ? formats.join(', ') : 'Not specified'}</dd></div>
            <div><dt>MFL theme</dt><dd>{dataset.mfl_theme ?? 'Not specified'}</dd></div>
          </dl>
          <h3>Full record</h3>
          {dataset.metadata_url ? (
            <p>
              The canonical metadata for this dataset is published as a STAC Item:{' '}
              <a href={dataset.metadata_url} target="_blank" rel="noopener noreferrer">view the record (JSON)</a>.
              <br />
              <code class="dp-url">{dataset.metadata_url}</code>
            </p>
          ) : (
            <p class="dp-muted">No STAC metadata record is registered for this dataset yet.</p>
          )}
        </section>

        <!-- Citation & contacts -->
        <section id="citation" class="dp-sec">
          <h2>Citation &amp; contacts</h2>
          <div class="dp-cite">
            {citation ? (
              <>
                <h3>How to cite</h3>
                <p class="dp-cite-text">{citation}</p>
              </>
            ) : (
              <>
                <h3>How to cite</h3>
                <p>
                  No citation is registered for this dataset yet.
                  {dataset.download_url
                    ? ' Cite the data as its source asks (see Access & use).'
                    : ' Ask the contact below how the data should be cited.'}
                  {' '}To point to this catalogue record, use:
                </p>
                <p class="dp-cite-text">
                  {dataset.title}. MOSAIC record {dataset.id}. {recordUrl} (accessed [date]).
                </p>
              </>
            )}
          </div>
          <h3>Contacts</h3>
          <p class="dp-muted">Who holds this dataset, and who to reach about it.</p>
          <ul class="dp-contacts">
            <li>
              <span class="dp-contact-role">Point of contact</span>
              {dataset.contact
                ? <a href={`mailto:${dataset.contact}?subject=${encodeURIComponent(`MOSAIC ${dataset.id}`)}`}>{dataset.contact}</a>
                : <span>Via the MOSAIC coordination team</span>}
            </li>
            {dataset.source && (
              <li>
                <span class="dp-contact-role">Source organization</span>
                <span>{dataset.source}</span>
              </li>
            )}
          </ul>
        </section>
      </div>

      <!-- Side column: the facts at a glance, and where to go next -->
      <aside class="dp-side" aria-label="Quick facts and related">
        <section class="dp-card">
          <h2>Quick facts</h2>
          <dl class="dp-facts">
            {quickFacts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
        </section>

        {related.length > 0 && (
          <section class="dp-card">
            <h2>Related datasets</h2>
            <ul class="dp-links">
              {related.map((r) => (
                <li>
                  <a href={`${base}/catalogue/${r.id}`}>{r.title}</a>
                  <span>{r.landscape_name ?? r.living_landscape}{r.mfl_theme ? ` · ${r.mfl_theme}` : ''}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="dp-card">
          <h2>Related links</h2>
          <ul class="dp-links">
            {hasLandscapePage && <li><a href={`${base}/landscapes#${dataset.living_landscape}`}>{landscapeLabel}: the landscape</a></li>}
            <li><a href={`${base}/catalogue?landscape=${dataset.living_landscape}`}>All datasets for {landscapeLabel}</a></li>
            {dataset.download_url && <li><a href={dataset.download_url} target="_blank" rel="noopener noreferrer">The data at its source ↗</a></li>}
          </ul>
        </section>
      </aside>
    </div>

    <!-- Back link -->
    <a id="back-to-catalogue" class="dp-small" href={`${base}/catalogue`}>&larr; Back to the catalogue</a>
  </div>

  <script is:inline>
    // One section at a time. The address keeps the choice (#access), so a
    // section can be linked to and the back button steps through them.
    (function () {
      var page = document.querySelector('.dp')
      var tabs = Array.prototype.slice.call(document.querySelectorAll('.dp-nav [data-tab]'))
      var panels = Array.prototype.slice.call(document.querySelectorAll('.dp-sec'))
      if (!page || !tabs.length) return
      var ids = panels.map(function (p) { return p.id })
      function show(id, focus) {
        if (ids.indexOf(id) === -1) id = ids[0]
        panels.forEach(function (p) { p.hidden = p.id !== id })
        tabs.forEach(function (t) {
          if (t.dataset.tab === id) t.setAttribute('aria-current', 'true')
          else t.removeAttribute('aria-current')
        })
        if (focus) {
          var nav = document.querySelector('.dp-nav')
          if (nav.getBoundingClientRect().top < 0 || nav.getBoundingClientRect().top > window.innerHeight * 0.6) {
            window.scrollTo({ top: nav.getBoundingClientRect().top + window.scrollY - 88 })
          }
        }
      }
      page.classList.add('is-tabbed')
      show(location.hash.slice(1), false)
      // every link on the page that points at a section switches to it
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href^="#"]')
        if (!a) return
        var id = a.getAttribute('href').slice(1)
        if (ids.indexOf(id) === -1) return
        e.preventDefault()
        history.pushState(null, '', '#' + id)
        show(id, true)
      })
      window.addEventListener('popstate', function () { show(location.hash.slice(1), false) })
    })()
  </script>

  <script is:inline define:vars={{ base }}>
    // Restore the catalogue view (filters/search/sort) the visitor came from.
    try {
      const qs = sessionStorage.getItem('mosaic:catalogue:qs')
      if (qs) {
        const link = document.getElementById('back-to-catalogue')
        if (link) link.setAttribute('href', `${base}/catalogue?${qs}`)
      }
    } catch (_) { /* storage unavailable */ }
  </script>
</BaseLayout>

<style>
  @import '../../styles/catalogue.css';

  .dp { max-width: 1120px; padding-top: var(--space-8); padding-bottom: var(--space-16); }

  /* header */
  .dp-head { padding-bottom: var(--space-6); }
  .dp-title { margin: 0 0 var(--space-2); }
  .dp-by { margin: 0 0 var(--space-1); font-size: var(--text-lg); color: var(--color-text); }
  .dp-part { margin: 0 0 var(--space-4); color: var(--color-muted); }
  .dp-meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-8); margin: 0 0 var(--space-6); }
  .dp-meta div { display: flex; align-items: baseline; gap: var(--space-2); }
  .dp-meta dt, .dp-contact-role {
    font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted);
  }
  .dp-meta dd { margin: 0; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-text); }
  .dp-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4); }
  .dp-action-link { font-size: var(--text-sm); font-weight: 600; }

  /* jump links */
  .dp-nav { border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-8); }
  .dp-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--space-6); }
  .dp-nav a { display: block; padding: var(--space-3) 0; font-weight: 600; font-size: var(--text-sm); text-decoration: none; color: var(--color-muted); }
  .dp-nav a:hover { color: var(--color-link); }
  .dp-nav a { border-bottom: 3px solid transparent; margin-bottom: -1px; }
  .dp-nav a[aria-current='true'] { color: var(--color-link); border-bottom-color: var(--color-link); }
  /* with the tabs running, the hidden sections are really hidden */
  .dp-sec[hidden] { display: none; }
  .is-tabbed .dp-sec { margin-bottom: 0; }

  /* two columns: sections | quick facts */
  .dp-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: var(--space-12); align-items: start; }
  @media (max-width: 900px) { .dp-layout { grid-template-columns: 1fr; gap: var(--space-8); } }

  .dp-sec { margin-bottom: var(--space-12); scroll-margin-top: 96px; }
  .dp-sec h2 { font-size: var(--text-2xl); margin: 0 0 var(--space-4); }
  .dp-sec h3 { font-size: var(--text-lg); margin: var(--space-6) 0 var(--space-3); }
  .dp-desc { font-size: var(--text-lg); color: var(--color-text); max-width: 68ch; margin: 0 0 var(--space-4); }
  .dp-muted { color: var(--color-muted); margin: 0 0 var(--space-3); }
  .dp-small { font-size: var(--text-sm); }
  .dp-tags { list-style: none; margin: 0 0 var(--space-6); padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .dp-tags li {
    padding: 0.1rem var(--space-3); border-radius: var(--radius-full);
    background: var(--color-gray-100); color: var(--color-gray-700); font-size: var(--text-sm);
  }
  .dp-note { padding: var(--space-4) var(--space-6); border-left: 4px solid var(--mosaic-amber); background: var(--color-gray-50); border-radius: 0 var(--radius-md) var(--radius-md) 0; }
  .dp-note h3 { margin: 0 0 var(--space-2); font-size: var(--text-base); font-family: var(--font-body); }
  .dp-note p { margin: 0 0 var(--space-2); font-size: var(--text-sm); }
  .dp-note summary { cursor: pointer; width: fit-content; font-size: var(--text-sm); font-weight: 600; color: var(--color-link); }
  .dp-note ul { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-muted); }

  /* label / value rows */
  .dp-kv { margin: 0; border-top: 1px solid var(--color-border); }
  .dp-kv div { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: var(--space-4); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-border); }
  .dp-kv dt { font-weight: 600; color: var(--color-text); font-size: var(--text-sm); }
  .dp-kv dd { margin: 0; color: var(--color-muted); font-size: var(--text-sm); overflow-wrap: anywhere; }
  @media (max-width: 520px) { .dp-kv div { grid-template-columns: 1fr; gap: 2px; } }
  .dp-url { font-size: var(--text-xs); color: var(--color-muted); word-break: break-all; }

  /* access box */
  .ds-access { padding: var(--space-6); margin-bottom: var(--space-6); background-color: var(--mosaic-light-teal); border-radius: var(--radius-lg); }
  .ds-access p { margin: 0 0 var(--space-4); }
  .ds-access-gee { margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--mosaic-teal); }
  .ds-access-gee p { margin-bottom: var(--space-2); }
  .ds-access-gee code { font-size: var(--text-xs); word-break: break-all; }

  /* citation and contacts */
  .dp-cite { padding: var(--space-6); background: var(--color-gray-50); border-left: 4px solid var(--mosaic-teal); border-radius: 0 var(--radius-md) var(--radius-md) 0; }
  .dp-cite h3 { margin-top: 0; }
  .dp-cite p { font-size: var(--text-sm); margin: 0 0 var(--space-3); }
  .dp-cite-text { font-family: var(--font-mono); line-height: 1.7; overflow-wrap: anywhere; }
  .dp-cite p:last-child { margin-bottom: 0; }
  .dp-contacts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-3); }
  .dp-contacts li { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); overflow-wrap: anywhere; }

  /* side column */
  .dp-side { display: grid; gap: var(--space-4); position: sticky; top: 96px; }
  @media (max-width: 900px) { .dp-side { position: static; } }
  .dp-card { padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .dp-card h2 { font-size: var(--text-lg); margin: 0 0 var(--space-3); }
  .dp-facts { margin: 0; display: grid; gap: var(--space-3); }
  .dp-facts dt { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); }
  .dp-facts dd { margin: 0; color: var(--color-text); }
  .dp-links { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); font-size: var(--text-sm); }
  .dp-links li { display: flex; flex-direction: column; gap: 2px; }
  .dp-links a { font-weight: 600; }
  .dp-links span { color: var(--color-muted); }

  /* "How to access this dataset" keeps its Light Teal background in both themes
     (a brand colour, never remapped), so in the dark theme its text stays dark
     too; headings and paragraphs would otherwise turn light on a light box. */
  :global([data-theme='dark']) .ds-access,
  :global([data-theme='dark']) .ds-access h2,
  :global([data-theme='dark']) .ds-access p,
  :global([data-theme='dark']) .ds-access strong,
  :global([data-theme='dark']) .ds-access code { color: var(--mosaic-ink); }
  /* …and its links keep Ocean Teal: the themed link colour is light there */
  :global([data-theme='dark']) .ds-access a:not(.btn) { color: var(--mosaic-teal); }
</style>
