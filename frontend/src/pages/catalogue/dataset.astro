---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { DatasetPage } from '../../components/dataset/DatasetPage'

// One page for every resource (/catalogue/dataset/?id=<source>:<id>): the resource is read from
// mosaic-api when the page opens, so a new record needs no rebuild of the website.
const base = import.meta.env.BASE_URL
---

<BaseLayout title="Dataset" description="A dataset in the MOSAIC catalogue.">
  <noscript>
    <div class="container" style="padding-top: var(--space-8);">
      <p>This page needs JavaScript to load the dataset from the MOSAIC API.</p>
    </div>
  </noscript>
  <DatasetPage client:only="react" base={base} />
</BaseLayout>

<style is:global>
  @import '../../styles/catalogue.css';
  @import '../../styles/dataset.css';
</style>
