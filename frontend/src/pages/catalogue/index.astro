---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/ui/PageHero.astro'
import { CatalogueApp } from '../../components/catalogue/CatalogueApp'
import { CatalogueStats } from '../../components/catalogue/CatalogueStats'
import LandscapeLocatorMap from '../../components/catalogue/LandscapeLocatorMap.astro'
import { readConfig } from '../../lib/config'

// No catalogue data at build time: the islands below read it from mosaic-api when the page opens.
const base = import.meta.env.BASE_URL
const api = readConfig()
const apiEntry = api.apiMode === 'static' ? `${api.apiUrl}/v1/manifest.json` : `${api.apiUrl}/docs`
---

<BaseLayout
  title="Dataset Catalogue"
  description="Browse and filter geospatial datasets from CGIAR centres across MFL Living Landscapes."
>
  <div class="catalogue-page">

    <!-- ── Hero ──────────────────────────────────────────────────
         Compact band with discreet contour lines instead of the illustrated
         landscape: this is a working tool, so the header gives up height to
         the results. "Dataset Catalogue" is the one Georgia title on the page. -->
    <PageHero
      variant="light"
      compact
      contours
      width="var(--catalogue-max)"
      title="Dataset Catalogue"
      subtitle="Search geospatial datasets by country, landscape, theme, organization or data type."
    />

    <!-- ── Figures (open strip, not dashboard tiles) ──────────── -->
    <p class="catalogue-band catalogue-statline">
      <CatalogueStats client:load />
    </p>

    <!-- ── Search + Filters + Results (primary task) ─────────── -->
    <noscript>
      <div class="catalogue-locator-wrap" style="padding-bottom: 0;">
        <p style="background: var(--mosaic-light-teal); border-radius: var(--radius-md); padding: var(--space-4) var(--space-5); color: var(--color-gray-700); font-size: var(--text-sm);">
          Interactive search and filtering need JavaScript. You can still reach the full,
          machine-readable catalogue through the
          <a href={apiEntry} style="color: var(--color-link); font-weight: 600;">MOSAIC API</a>.
        </p>
      </div>
    </noscript>
    <CatalogueApp client:load base={base} />

    <!-- ── Locator map (supporting context) ──────────────────── -->
    <div class="catalogue-locator-wrap">
      <LandscapeLocatorMap />
    </div>

    <!-- ── Technical access (secondary, for advanced users) ──── -->
    <p class="catalogue-band catalogue-tech-access">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" />
      </svg>
      Technical access:
      <a href={apiEntry} target="_blank" rel="noopener noreferrer">MOSAIC API</a>
      — the machine-readable catalogue (MOSAIC and the catalogues it connects to).
    </p>

  </div>
</BaseLayout>

<style is:global>
  @import '../../styles/catalogue.css';
</style>

<style>
  .catalogue-tech-access {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-4) 0 var(--space-12);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .catalogue-tech-access svg { flex: 0 0 auto; color: var(--color-muted); }
  .catalogue-tech-access a { color: var(--color-link); font-weight: 600; }
</style>
