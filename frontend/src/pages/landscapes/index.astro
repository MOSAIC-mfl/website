---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/ui/PageHero.astro'
import IconChip from '../../components/ui/IconChip.astro'
import LandscapeCard from '../../components/catalogue/LandscapeCard.astro'
import CtaBand from '../../components/ui/CtaBand.astro'
import landscapes from '../../../data/landscapes.json'
import datasets from '../../../data/datasets.json'
import boundaries from '../../../data/landscape_boundaries.json'

const base = import.meta.env.BASE_URL

const fileSize = (bytes: number) =>
  bytes < 1e6 ? `${Math.round(bytes / 1e3)} KB` : `${(bytes / 1e6).toFixed(1)} MB`
const boundaryRows = [...boundaries.landscapes].sort((a, b) => a.name.localeCompare(b.name))

const landscapesWithCounts = landscapes
  .map((l) => ({
    ...l,
    count: datasets.filter((d) => d.living_landscape === l.code).length,
  }))
  .sort((a, b) => b.count - a.count)

const pillars = [
  { icon: 'map-pin', label: 'Place-based', caption: 'Real-world landscapes where we work', tint: 'teal' },
  { icon: 'users', label: 'Collaborative', caption: 'Multiple CGIAR centres working together', tint: 'amber' },
  { icon: 'bar-chart', label: 'Outcome-driven', caption: 'Measurable impact for people and nature', tint: 'light-teal' },
  { icon: 'eye', label: 'Monitored', caption: 'Continuous learning and improvement', tint: 'terracotta' },
] as const
---

<BaseLayout title="Living Landscapes" description="Overview of the MFL Living Landscapes — the flagship landscapes where CGIAR centres work together.">
  <PageHero
    variant="light"
    compact
    contours
    title="Living Landscapes"
    subtitle="Flagship landscapes where CGIAR centres are working together to restore, sustain, and monitor multifunctional landscapes."
  />

  <div class="container lp-body">

    <!-- Intro + pillars -->
    <section class="lp-intro">
      <div class="lp-intro-text">
        <p>
          Living Landscapes are the geographies where the MFL Science Programme focuses its work.
          Each landscape is a real place — a watershed, a highland, a valley — where multiple CGIAR
          centres are active and where the programme aims to achieve measurable outcomes for people and nature.
        </p>
        <div class="lp-intro-links">
          <a href={`${base}/about`} class="lp-approach-link">About our approach &rarr;</a>
          <a href="#download" class="lp-approach-link">Download the boundaries &darr;</a>
        </div>
      </div>
      <div class="lp-chips">
        {pillars.map((p) => (
          <IconChip icon={p.icon} label={p.label} caption={p.caption} tint={p.tint} align="center" />
        ))}
      </div>
    </section>

    <!-- Search toolbar -->
    <div class="lp-tools">
      <div class="lp-search-wrap">
        <span class="lp-search-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </span>
        <label for="lp-search" class="sr-only">Search landscapes</label>
        <input id="lp-search" type="search" class="lp-search" placeholder="Search landscapes by name, code or country…" />
      </div>
      <span id="lp-count" class="lp-count">Showing all landscapes</span>
    </div>

    <!-- Landscape grid -->
    <ul class="lp-grid" id="lp-grid">
      {landscapesWithCounts.map((l) => (
        <li class="lp-item" data-search={`${l.name} ${l.code} ${l.country}`.toLowerCase()}>
          <LandscapeCard
            code={l.code}
            name={l.name}
            country={l.country}
            count={l.count}
            pending={'pending' in l && l.pending === true}
            href={`${base}/catalogue?landscape=${l.code}`}
          />
        </li>
      ))}
    </ul>
    <p id="lp-empty" class="lp-empty" hidden>No landscapes match your search.</p>

    <!-- Boundary downloads (files attached to a release of the catalog repository on GitHub) -->
    <section id="download" class="lp-download" aria-labelledby="lp-download-title">
      <h2 id="lp-download-title" class="lp-download-title">Download the boundaries</h2>
      <p class="lp-download-lede">
        The outlines MOSAIC uses for the {boundaries.landscapes.length} living landscapes, at full detail,
        in WGS&nbsp;84 (EPSG:4326). Each source has its own terms: keep the credit with the data and in any map
        made from it. Every download includes a README with the source, licence and full credit.
      </p>

      <div class="lp-download-all">
        {boundaries.all.map((a, i) => (
          <a class={`btn ${i === 0 ? 'btn-primary' : 'btn-secondary'}`} href={`${boundaries.download_base}${a.file}`}>
            All landscapes · {a.format}
            <span class="lp-size">{fileSize(a.bytes)}</span>
          </a>
        ))}
      </div>

      <ul class="lp-dl-list">
        {boundaryRows.map((l) => (
          <li class="lp-dl-row">
            <div class="lp-dl-name">
              <strong>{l.name}</strong>
              <span class="lp-dl-meta">{l.code} · {l.country}</span>
              {l.note && <span class="lp-dl-note">{l.note}</span>}
            </div>
            <div class="lp-dl-licence">
              {l.licence_url
                ? <a href={l.licence_url} target="_blank" rel="noopener">{l.licence_label}</a>
                : <span>{l.licence_label}</span>}
            </div>
            <a class="lp-dl-link" href={`${boundaries.download_base}${l.file}`}>
              Shapefile <span class="lp-size">{fileSize(l.bytes)}</span>
            </a>
            <details class="lp-dl-credit">
              <summary>Credit to keep with the data</summary>
              <p>{l.credit}</p>
            </details>
          </li>
        ))}
      </ul>

      <p class="lp-dl-foot">
        Version {boundaries.version}.
        <a href={boundaries.release_url} target="_blank" rel="noopener">All files of this version</a>
        · <a href={`${boundaries.download_base}${boundaries.readme}`}>README</a>
        · Simplified outlines for web maps are in the
        <a href="https://mosaic-mfl.github.io/catalog/stac/catalog.json" target="_blank" rel="noopener">STAC catalog</a>.
      </p>
    </section>

  </div>

  <CtaBand
    variant="soft"
    tint="sand"
    title="Don't see a landscape you work in?"
    body="Help us expand the network by contributing data or suggesting a new landscape."
    primaryCta={{ label: 'Contribute data', href: `${base}/contribute` }}
  >
    <img slot="art" src={`${base}/illustrations/seedling.png`} alt="" />
  </CtaBand>
</BaseLayout>

<style>
  .lp-body {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  /* Intro + pillars */
  .lp-intro {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-8);
    align-items: center;
    margin-bottom: var(--space-12);
  }
  .lp-intro-text p {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }
  .lp-approach-link {
    font-weight: 600;
    color: var(--mosaic-teal);
    text-decoration: none;
  }
  .lp-chips {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  /* Toolbar */
  .lp-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }
  .lp-search-wrap {
    position: relative;
    flex: 1;
    min-width: 260px;
    max-width: 460px;
  }
  .lp-search-icon {
    position: absolute;
    left: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-muted);
    display: inline-flex;
  }
  .lp-search {
    width: 100%;
    padding: var(--space-3) var(--space-3) var(--space-3) calc(var(--space-6) + var(--space-2));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-base);
    font-family: var(--font-body);
  }
  .lp-search:focus-visible {
    outline: 2px solid var(--mosaic-teal);
    outline-offset: 1px;
    border-color: var(--mosaic-teal);
  }
  .lp-count {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* Grid */
  .lp-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
  }
  .lp-empty {
    margin: var(--space-8) 0 0;
    color: var(--color-muted);
    font-size: var(--text-base);
  }

  .lp-intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  /* Boundary downloads */
  .lp-download {
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 6rem;
  }
  .lp-download-title {
    font-family: var(--font-title);
    font-weight: normal;
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-3);
  }
  .lp-download-lede {
    max-width: 68ch;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0 0 var(--space-6);
  }
  .lp-download-all {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .lp-size {
    font-weight: 400;
    font-size: var(--text-sm);
    opacity: 0.8;
    font-variant-numeric: tabular-nums;
  }
  .lp-dl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }
  .lp-dl-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 11rem 9rem;
    gap: var(--space-1) var(--space-6);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .lp-dl-name strong {
    margin-right: var(--space-2);
  }
  .lp-dl-meta {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .lp-dl-note {
    display: block;
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-style: italic;
  }
  .lp-dl-licence {
    font-size: var(--text-sm);
  }
  .lp-dl-licence a,
  .lp-dl-foot a {
    color: var(--mosaic-teal);
  }
  .lp-dl-link {
    font-weight: 600;
    color: var(--mosaic-teal);
    text-decoration: none;
    justify-self: end;
  }
  .lp-dl-link:hover {
    text-decoration: underline;
  }
  .lp-dl-credit {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .lp-dl-credit summary {
    cursor: pointer;
    width: fit-content;
  }
  .lp-dl-credit p {
    max-width: 90ch;
    margin: var(--space-2) 0 0;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .lp-dl-foot {
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .lp-dl-link:focus-visible,
  .lp-dl-licence a:focus-visible,
  .lp-dl-credit summary:focus-visible {
    outline: 2px solid var(--mosaic-teal);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 767px) {
    .lp-intro { grid-template-columns: 1fr; }
    .lp-dl-row { grid-template-columns: minmax(0, 1fr) auto; }
    .lp-dl-name { grid-column: 1 / -1; }
    .lp-dl-link { justify-self: end; }
  }
  @media (max-width: 480px) {
    .lp-chips { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Lightweight client-side landscape filter (no dependency, no React island).
  const input = document.getElementById('lp-search') as HTMLInputElement | null
  const items = Array.from(document.querySelectorAll<HTMLElement>('.lp-item'))
  const countEl = document.getElementById('lp-count')
  const emptyEl = document.getElementById('lp-empty')
  const total = items.length

  function apply() {
    const q = (input?.value ?? '').trim().toLowerCase()
    let shown = 0
    for (const li of items) {
      const hay = li.getAttribute('data-search') ?? ''
      const match = !q || hay.includes(q)
      li.style.display = match ? '' : 'none'
      if (match) shown++
    }
    if (countEl) countEl.textContent = q ? `Showing ${shown} of ${total} landscapes` : 'Showing all landscapes'
    if (emptyEl) emptyEl.hidden = shown !== 0
  }

  input?.addEventListener('input', apply)
</script>
