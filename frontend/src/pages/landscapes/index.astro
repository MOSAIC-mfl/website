---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/ui/PageHero.astro'
import LandscapeExplorer from '../../components/landscapes/LandscapeExplorer.astro'
import CtaBand from '../../components/ui/CtaBand.astro'
import boundaries from '../../../data/landscape_boundaries.json'

const base = import.meta.env.BASE_URL

const fileSize = (bytes: number) =>
  bytes < 1e6 ? `${Math.round(bytes / 1e3)} KB` : `${(bytes / 1e6).toFixed(1)} MB`
---

<BaseLayout title="Living Landscapes" description="Overview of the MFL Living Landscapes — the flagship landscapes where CGIAR centres work together.">
  <PageHero
    variant="light"
    compact
    contours
    title="Living Landscapes"
    subtitle="The real places where CGIAR centres work together for people and nature. Choose a landscape to see where it is, what it is like and what data exists for it."
  />

  <div class="lp-wide">
    <LandscapeExplorer />
  </div>

  <div class="container lp-body">
    <!-- Boundary downloads (files attached to a release of the catalog repository on GitHub) -->
    <section id="download" class="lp-download" aria-labelledby="lp-download-title">
      <h2 id="lp-download-title" class="lp-download-title">Download the boundaries</h2>
      <p class="lp-download-lede">
        The outlines MOSAIC uses for the {boundaries.landscapes.length} living landscapes, at full detail,
        in WGS&nbsp;84 (EPSG:4326). Each source has its own terms: keep the credit with the data and in any map
        made from it. Every download includes a README with the source, licence and full credit.
        Download all landscapes here, or one landscape with <strong>Download boundary</strong> above.
      </p>

      <div class="lp-download-all">
        {boundaries.all.map((a, i) => (
          <a class={`btn ${i === 0 ? 'btn-primary' : 'btn-secondary'}`} href={`${boundaries.download_base}${a.file}`}>
            All landscapes · {a.format}
            <span class="lp-size">{fileSize(a.bytes)}</span>
          </a>
        ))}
      </div>

      <p class="lp-dl-foot">Version {boundaries.version}.</p>
    </section>

  </div>

  <CtaBand
    variant="soft"
    tint="sand"
    title="Don't see a landscape you work in?"
    body="Help us expand the network by contributing data or suggesting a new landscape."
    primaryCta={{ label: 'Contribute data', href: `${base}/about#contribute` }}
  />
</BaseLayout>

<style>
  .lp-wide {
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) 0;
  }
  @media (max-width: 640px) {
    .lp-wide { padding: var(--space-6) var(--space-4) 0; }
  }

  .lp-body {
    padding-top: 0;
    padding-bottom: var(--space-16);
  }

  /* Boundary downloads */
  .lp-download {
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 6rem;
  }
  .lp-download-title {
    font-family: var(--font-title);
    font-weight: normal;
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-3);
  }
  .lp-download-lede {
    max-width: 68ch;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0 0 var(--space-6);
  }
  .lp-download-all {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .lp-size {
    font-weight: 400;
    font-size: var(--text-sm);
    opacity: 0.8;
    font-variant-numeric: tabular-nums;
  }
  .lp-dl-foot {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

</style>
