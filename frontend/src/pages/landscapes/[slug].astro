---
/**
 * One page per living landscape (/landscapes/<code>/, e.g. /landscapes/ken-lvb/). The list of
 * landscapes is the site's own (data/landscapes.json); the page content - its sections, the map
 * explorer of a curated profile, datasets and data status - is read from mosaic-api when the page
 * opens, so a new or updated profile needs no website rebuild.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/ui/PageHero.astro'
import Breadcrumb from '../../components/ui/Breadcrumb.astro'
import { LandscapePage } from '../../features/landscape/LandscapePage'
import landscapes from '../../../data/landscapes.json'

export function getStaticPaths() {
  return landscapes.map((l) => ({ params: { slug: l.code.toLowerCase() }, props: { landscape: l } }))
}

const { landscape } = Astro.props as { landscape: { code: string; name: string; country: string } }
const base = import.meta.env.BASE_URL
---

<BaseLayout
  title={landscape.name}
  description={`Living landscape profile: ${landscape.name} (${landscape.country}). Maps, datasets and data status from the MOSAIC catalogue.`}
>
  <div class="container lp-crumb">
    <Breadcrumb
      crumbs={[
        { label: 'Home', href: `${base}/` },
        { label: 'Living Landscapes', href: `${base}/landscapes/` },
        { label: landscape.name },
      ]}
    />
  </div>
  <PageHero variant="light" compact contours eyebrow={`${landscape.code} · ${landscape.country}`} title={landscape.name} />
  <LandscapePage client:only="react" code={landscape.code} base={base} />
  <noscript>
    <div class="container"><p>This page needs JavaScript to load the landscape profile from the MOSAIC API.</p></div>
  </noscript>
</BaseLayout>

<script>
  // the map explorer fills the screen below the sticky site header and the section navigation
  const root = document.documentElement
  const measure = () => {
    const header = document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 0
    const nav = document.querySelector<HTMLElement>('.lp-nav')?.offsetHeight ?? 0
    root.style.setProperty('--site-header-h', `${header}px`)
    root.style.setProperty('--lp-nav-h', `${nav}px`)
  }
  measure()
  window.addEventListener('resize', measure)
  new MutationObserver(measure).observe(document.body, { childList: true, subtree: true })
</script>

<style is:global>
  @import '../../styles/catalogue.css';
  @import '../../styles/landscape.css';
  @import '../../styles/explorer.css';
</style>
