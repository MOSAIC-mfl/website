  .lx-pick-value { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .lx-pick-name { font-family: var(--font-title); font-weight: 700; font-size: var(--text-lg); line-height: 1.2; }
  .lx-pick-country { font-size: var(--text-sm); color: var(--color-muted); }
