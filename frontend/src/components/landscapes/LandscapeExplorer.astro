</style>

<script>
  import { mountExplorer } from './explorer/controller'
  import { apiExplorerData } from '../../lib/ui/landscape-explorer-data'

  const live = apiExplorerData()
  for (const root of document.querySelectorAll<HTMLElement>('[data-lx]')) mountExplorer(root, live)
</script>
