    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    align-items: stretch;
  }
  .lx-grid:has(.lx-photo[hidden]) .lx-map { grid-column: 1 / -1; }

  /* photos */
  .lx-photo { position: relative; margin: 0; border-radius: var(--radius-lg); overflow: hidden; min-height: 380px; background: var(--color-bg); }
  .lx-photo[hidden] { display: none; }
