---
/**
 * LandscapeExplorer — the Landscapes page's main panel: a list of the living
 * landscapes on the left, and the selected one on the right (photo carousel,
 * animated locator map with an inset globe, key facts, dataset counter and
 * actions).
 *
 * The site's own landscape data is rendered at build time:
 *   data/landscapes.json            names, countries, pending flag
 *   data/landscape_outlines.json    simplified canonical boundaries (map)
 *   data/landscape_centroids.json   pin positions
 *   data/landscape_geo.json         area + country outlines (scripts/build_landscape_geo.py)
 *   data/world_land_path.json       land silhouette under the countries
 *   data/landscape_labels.json      places, rivers, lakes (Natural Earth; scripts/build_map_labels.py)
 *                                   — not in the page: served as /landscapes/map-detail.json and
 *                                   fetched when a landscape is first opened
 *   data/landscape_photos.json      open-licence photos with credit (optional)
 *   data/landscape_profiles.json    short descriptions (optional)
 *
 * Figures from the catalogue are not: dataset counts, data coverage, open
 * access and whether a landscape has a map profile ("Map visualization") are
 * read from mosaic-api in the browser (explorer/controller.ts, through
 * lib/ui/landscape-explorer-data.ts), so a new dataset or profile needs no
 * rebuild. Until they arrive the figures read "–".
 *
 * The first landscape is rendered as HTML; the controller then swaps the
 * content when another one is selected (no framework island). Motion is
 * dropped for visitors who ask for reduced motion.
 */
import Icon from '../ui/Icon.astro'
import landscapes from '../../../data/landscapes.json'
import outlineData from '../../../data/landscape_outlines.json'
import centroidData from '../../../data/landscape_centroids.json'
import geo from '../../../data/landscape_geo.json'
import world from '../../../data/world_land_path.json'
import boundaries from '../../../data/landscape_boundaries.json'
import { VOCAB_LABELS } from '../../lib/domain/vocab-labels'

interface Photo {
  file: string
  width?: number
  height?: number
  alt: string
  caption?: string | null
  author: string
  licence: string
  licence_url?: string | null
  source_url: string
}
interface Resource {
  title: string
  type?: string | null
  authors?: string | null
  org?: string | null
  year?: number | null
  extent?: string | null
  licence?: string | null
  url: string
  note?: string | null
}
interface Profile {
  summary?: string | null
  ecosystem?: string | null
  livelihoods?: string | null
  why_it_matters?: string | null
  // Published work about the landscape, shown in "Other resources". A landscape
  // with none keeps the "under construction" card.
  resources?: Resource[]
  // Where each description comes from: { field, source (a public address), note }.
  sources?: { field: string; source: string; note?: string | null }[]
}

// Optional inputs: the page builds without them (empty photo slot, facts only).
const optional = import.meta.glob<{ default: Record<string, unknown> }>(
  '../../../data/landscape_{photos,profiles}.json',
  { eager: true },
)
const pick = (name: string) =>
  Object.entries(optional).find(([k]) => k.endsWith(name))?.[1]?.default ?? {}
const photoMap = ((pick('landscape_photos.json') as { photos?: Record<string, Photo[]> }).photos ?? {})
const profileMap = ((pick('landscape_profiles.json') as { profiles?: Record<string, Profile> }).profiles ?? {})

const base = import.meta.env.BASE_URL
// The standard's themes: the ring reads "n of 16" (the figures come from mosaic-api).
const themeList = Object.values(VOCAB_LABELS.theme)

const fileSize = (bytes: number) =>
  bytes < 1e6 ? `${Math.round(bytes / 1e3)} KB` : `${(bytes / 1e6).toFixed(1)} MB`
const formatHa = (ha: number) => {
  const digits = Math.max(0, Math.floor(Math.log10(ha)) - 2) // 3 significant figures
  const rounded = Math.round(ha / 10 ** digits) * 10 ** digits
  return `${rounded.toLocaleString('en-US')} ha`
}

// Sources of the four descriptions, one row per address: the site it is on and
// the descriptions it backs. The working notes kept beside each source in the
// data file are for editors and are not shown.
const SOURCE_FIELD: Record<string, string> = {
  summary: 'Summary',
  ecosystem: 'Ecosystems',
  livelihoods: 'People and livelihoods',
  why_it_matters: 'Why it matters',
}
function sourceList(p: Profile) {
  const byUrl = new Map<string, string[]>()
  for (const s of p.sources ?? []) {
    if (!/^https?:\/\//.test(s.source)) continue
    const label = SOURCE_FIELD[s.field] ?? s.field
    const seen = byUrl.get(s.source) ?? []
    if (!seen.includes(label)) seen.push(label)
    byUrl.set(s.source, seen)
  }
  return [...byUrl].map(([url, fields]) => ({
    url,
    host: new URL(url).hostname.replace(/^www\./, ''),
    fields: fields.join(', '),
  }))
}

// Where each name sits on the start map when all eleven are shown at once
// (wide screens): above its pin unless a neighbour is in the way. x / y move
// the label in map units; anchor is which end of the text sits at that point.
const LABEL_AT: Record<string, { x: number; y: number; anchor: 'start' | 'end' }> = {
  'CIV-NZ': { x: 4, y: 4.8, anchor: 'start' },
  'ETH-OG': { x: 4, y: 4.8, anchor: 'start' },
  'KEN-LVB': { x: -4, y: 4.8, anchor: 'end' },
  'KEN-LEI': { x: 4, y: 5.4, anchor: 'start' },
  'ZWE-MB': { x: 4, y: 4.8, anchor: 'start' },
  'MEK-3S': { x: -4, y: 4.8, anchor: 'end' },
}
const labelStyle = (code: string) => {
  const at = LABEL_AT[code]
  return at ? `--lx:${at.x}px;--ly:${at.y}px;--la:${at.anchor}` : undefined
}

const geoLandscapes = geo.landscapes as Record<string, { area_ha: number; countries: string[] }>
const geoCountries = geo.countries as Record<string, { name: string; d: string; bbox: number[]; globe: number[][][] }>
const outlines = outlineData.outlines as Record<string, { d: string; bbox: number[] }>
const centroids = new Map(centroidData.landscapes.map((c) => [c.code, c]))
const boundaryByCode = new Map(boundaries.landscapes.map((b) => [b.code, b]))

const items = landscapes
  .map((l) => {
    const g = geoLandscapes[l.code]
    const c = centroids.get(l.code)
    const b = boundaryByCode.get(l.code)
    const p = profileMap[l.code] ?? {}
    // Union of the landscape's countries = the map's resting view.
    const cb = g.countries
      .map((iso) => geoCountries[iso]?.bbox)
      .filter(Boolean)
      .reduce((a, v) => [Math.min(a[0], v[0]), Math.min(a[1], v[1]), Math.max(a[2], v[2]), Math.max(a[3], v[3])],
        [Infinity, Infinity, -Infinity, -Infinity])
    return {
      code: l.code,
      name: l.name,
      country: l.country,
      pending: 'pending' in l && l.pending === true,
      area: formatHa(g.area_ha),
      countries: g.countries,
      view: cb,
      bbox: outlines[l.code].bbox,
      lon: c?.lon ?? 0,
      lat: c?.lat ?? 0,
      photos: (photoMap[l.code] ?? []).map((ph) => ({ ...ph, src: `${base}/${ph.file}` })),
      summary: p.summary ?? null,
      ecosystem: p.ecosystem ?? null,
      livelihoods: p.livelihoods ?? null,
      why: p.why_it_matters ?? null,
      resources: p.resources ?? [],
      sources: sourceList(p),
      catalogue: `${base}/catalogue?landscape=${l.code}`,
      boundary: b ? { href: `${boundaries.download_base}${b.file}`, size: fileSize(b.bytes) } : null,
    }
  })
  // by name here; the controller puts the landscapes with most datasets first once mosaic-api answers
  .sort((a, b) => a.name.localeCompare(b.name))

const first = items[0]

// Left-hand section menu. Overview always; Map visualization only for a landscape
// with a map profile (the controller shows the entry); the others show an
// "under construction" notice until their content exists.
const sectionList = [
  { id: 'overview', label: 'Overview', icon: 'grid', ready: true },
  { id: 'map', label: 'Map visualization', icon: 'globe', ready: true },
  { id: 'knowledge-hub', label: 'Knowledge hub', icon: 'link', ready: false },
  { id: 'resources', label: 'Other resources', icon: 'folder', ready: false },
] as const
const soon: Record<string, { title: string; text: string }> = {
  'knowledge-hub': {
    title: 'Knowledge hub',
    text: 'Evidence, actions and lessons from this landscape, connected to the data behind them, are on their way. In the meantime, the catalogue lists the datasets already registered here.',
  },
  resources: {
    title: 'Other resources',
    text: 'Reports and useful links for this landscape will be gathered here. In the meantime, the catalogue lists the datasets already registered for it.',
  },
}
const globeCountries = Object.entries(geoCountries).map(([iso, c]) => ({ iso, rings: c.globe }))
const mapCountries = Object.entries(geoCountries).filter(([, c]) => c.d)
// Label data for the client: places [name, x, y, minZoom, capital]; river label
// anchors; lake label points. River and lake shapes are drawn below in the SVG.
// "Select a landscape" start screen: every landscape on one world map, framed
// on their pins (equirectangular units, as the main map: x = lon + 180, y = 90 − lat).
const introCountries = [...new Set(items.flatMap((it) => it.countries))]
const introView = (() => {
  const xs = items.map((it) => it.lon + 180)
  const ys = items.map((it) => 90 - it.lat)
  const x0 = Math.min(...xs) - 16, x1 = Math.max(...xs) + 16
  const yc = (Math.min(...ys) + Math.max(...ys)) / 2
  const h = Math.max(Math.max(...ys) - Math.min(...ys) + 24, (x1 - x0) / 3)
  return [x0, yc - h / 2, x1 - x0, h].map((v) => Math.round(v * 10) / 10)
})()
const codes = items.map((it) => it.code)
---

<section class="lx" data-lx data-detail-url={`${base}/landscapes/map-detail.json`} data-base={base} aria-label="Living landscape explorer">
  <script type="application/json" data-lx-data set:html={JSON.stringify({ items, globe: globeCountries })} />
  <!-- Before first paint: .is-live shows the world map (start screen, then a
       compact strip that stays as the thread); with no landscape in the address,
       .is-intro starts on the "Select a landscape" screen. Without JavaScript
       the first landscape is shown, as before. -->
  <script is:inline define:vars={{ codes }}>
    var lxRoot = document.currentScript.parentElement
    var lxCode = decodeURIComponent(location.hash.slice(1)).split('/')[0]
    lxRoot.classList.add('is-live')
    if (codes.indexOf(lxCode) === -1) lxRoot.classList.add('is-intro')
  </script>

  <!-- The world's land and the country outlines, drawn once. Both maps below
       point at these shapes instead of carrying their own copy; colours come
       from each map's own classes. -->
  <svg class="lx-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <path id="lx-shape-land" d={world.d} />
      {mapCountries.map(([iso, c]) => (
        <path id={`lx-shape-${iso}`} d={c.d} fill-rule="evenodd" vector-effect="non-scaling-stroke" />
      ))}
    </defs>
  </svg>

  <!-- Landscape selector (a filter for the whole panel) -->
  <div class="lx-top">
    <span class="lx-top-label" id="lx-pick-label">Living landscape</span>
    <div class="lx-pick" data-pick>
      <button type="button" class="lx-pick-btn" data-pick-btn aria-haspopup="listbox" aria-expanded="false" aria-labelledby="lx-pick-label lx-pick-value">
        <span class="lx-item-pin"><Icon name="map-pin" size={18} /></span>
        <span class="lx-pick-value" id="lx-pick-value">
          <span class="lx-pick-prompt">Select a landscape</span>
          <span class="lx-pick-name" data-pick-name>{first.name}</span>
          <span class="lx-pick-country" data-pick-country>{first.country}</span>
        </span>
        <span class="lx-pick-chev" aria-hidden="true"><Icon name="chevron-right" size={18} /></span>
      </button>
      <div class="lx-pop" data-pop hidden>
        <div class="lx-search">
          <Icon name="search" size={18} />
          <label for="lx-search" class="sr-only">Search landscapes by name or country</label>
          <input id="lx-search" type="search" placeholder="Search by name or country…" autocomplete="off" />
        </div>
        <ul class="lx-list" role="listbox" aria-label="Living landscapes">
          {items.map((it, i) => (
            <li
              class="lx-item"
              role="option"
              tabindex="-1"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-code={it.code}
              data-search={`${it.name} ${it.country} ${it.code}`.toLowerCase()}
            >
              <span class="lx-item-pin"><Icon name="map-pin" size={18} /></span>
              <span class="lx-item-text">
                <span class="lx-item-name">{it.name}</span>
                <span class="lx-item-country">{it.country}</span>
              </span>
              <span class="lx-item-count">–</span>
            </li>
          ))}
        </ul>
        <p class="lx-empty" hidden>No landscapes match your search.</p>
      </div>
    </div>
  </div>

  <!-- World map: the start screen (map + list), then a compact strip above the
       chosen landscape, its pin highlighted, so the global view stays in sight -->
  <div class="lx-intro" data-intro>
    <div class="lx-intro-head">
      <h2 class="lx-intro-title">{items.length} living landscapes in {introCountries.length} countries</h2>
      <p class="lx-intro-lead">Choose one on the map, or from the list at the top, to see its overview.</p>
    </div>
    <div class="lx-gm-row">
    <div class="lx-intro-map">
      <svg data-world viewBox={introView.join(' ')} preserveAspectRatio="xMidYMid meet" role="group" aria-label="Map of the living landscapes">
        <use class="lx-land" href="#lx-shape-land" />
        {mapCountries.map(([iso]) => (
          <use class:list={['lx-ctry', { 'is-home': introCountries.includes(iso) }]} href={`#lx-shape-${iso}`} />
        ))}
        {items.map((it, i) => (
          <a class="lx-ip" href={`#${it.code}`} data-ip={it.code} style={`--i:${i}`} aria-label={`${it.name}, ${it.country}`}>
            <g transform={`translate(${Math.round((it.lon + 180) * 100) / 100} ${Math.round((90 - it.lat) * 100) / 100})`}>
              <g class="lx-ip-body">
                <circle class="lx-ip-halo" r="3.2" />
                <circle class="lx-ip-dot" r="1.5" />
              </g>
              <text class="lx-ip-name" y="-4" style={labelStyle(it.code)}>{it.name}</text>
            </g>
          </a>
        ))}
      </svg>
    </div>
    <div class="lx-gm-side">
      <p class="lx-gm-kicker">Living landscapes</p>
      <p class="lx-gm-count">{items.length} landscapes in {introCountries.length} countries</p>
      <p class="lx-gm-hint">Pick another pin on the map to switch.</p>
      <a class="lx-gm-all" href={`${base}/landscapes`} data-gm-all><Icon name="grid" size={16} /> See all landscapes</a>
    </div>
    </div>
  </div>

  <div class="lx-body">
    <!-- Section menu -->
    <nav class="lx-secnav" data-secnav aria-label="Landscape sections">
      <div class="lx-secnav-head">
        <span class="lx-secnav-title">Sections</span>
        <button type="button" class="lx-secnav-toggle" data-secnav-toggle aria-label="Collapse the section menu" aria-expanded="true">«</button>
      </div>
      <ul>
        {sectionList.map((sec, i) => (
          <li hidden={sec.id === 'map'}>
            <a href={`#${first.code}/${sec.id}`} data-sec={sec.id} aria-current={i === 0 ? 'true' : undefined} title={sec.label}>
              <Icon name={sec.icon} size={20} />
              <span class="lx-sec-label">{sec.label}</span>
              {!sec.ready && (
                <span class="lx-sec-soon" data-sec-soon={sec.id} hidden={sec.id === 'resources' && first.resources.length > 0}>Soon</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="lx-content">
  <!-- Detail -->
  <article class="lx-main" data-panel="overview" aria-live="polite">
    <header class="lx-head">
      <div class="lx-anim">
        <h2 class="lx-title" data-f="name">{first.name}</h2>
        <p class="lx-country">
          <Icon name="map-pin" size={18} />
          <span data-f="country">{first.country}</span>
          <span class="lx-pending" data-f="pending" hidden={!first.pending}>Name pending confirmation</span>
        </p>
        <p class="lx-summary" data-f="summary">{first.summary ?? ''}</p>
      </div>
      <a class="lx-badge" data-f="catalogue" href={first.catalogue}>
        <Icon name="layers" size={30} />
        <span class="lx-badge-num" data-f="count">–</span>
        <span class="lx-badge-lbl" data-f="count-label">datasets</span>
      </a>
    </header>

    <div class="lx-grid">
      <!-- Photos -->
      <figure class="lx-photo" data-photo hidden={first.photos.length === 0}>
        <div class="lx-photo-stack" data-photo-stack>
          {first.photos.map((ph, i) => (
            <img
              src={ph.src}
              alt={ph.alt}
              width={ph.width}
              height={ph.height}
              class:list={['lx-photo-img', { 'is-on': i === 0 }]}
              loading="lazy"
              decoding="async"
            />
          ))}
        </div>
        <button type="button" class="lx-nav lx-prev" data-photo-prev aria-label="Previous photo" hidden={first.photos.length < 2}><Icon name="chevron-right" size={20} /></button>
        <button type="button" class="lx-nav lx-next" data-photo-next aria-label="Next photo" hidden={first.photos.length < 2}><Icon name="chevron-right" size={20} /></button>
        <span class="lx-count" data-photo-count hidden={first.photos.length < 2}>1 / {first.photos.length}</span>
        <div class="lx-dots" data-dots role="tablist" aria-label="Photos">
          {first.photos.map((_, i) => (
            <button type="button" class:list={['lx-dot', { 'is-on': i === 0 }]} aria-label={`Photo ${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'} role="tab"></button>
          ))}
        </div>
        <figcaption class="lx-credit" data-credit>
          {first.photos[0] && (
            <>
              {first.photos[0].caption && <span>{first.photos[0].caption} · </span>}
              Photo: <a href={first.photos[0].source_url} target="_blank" rel="noopener">{first.photos[0].author}</a>,
              {first.photos[0].licence_url
                ? <a href={first.photos[0].licence_url} target="_blank" rel="noopener"> {first.photos[0].licence}</a>
                : <span> {first.photos[0].licence}</span>}
            </>
          )}
        </figcaption>
      </figure>

      <!-- Map -->
      <div class="lx-map" data-map>
        <svg class="lx-map-svg" data-map-svg viewBox={`${first.view[0]} ${first.view[1]} ${first.view[2] - first.view[0]} ${first.view[3] - first.view[1]}`} preserveAspectRatio="xMidYMid meet" tabindex="0" role="img" aria-label={`Map of ${first.name}`}>
          <use class="lx-land" href="#lx-shape-land" />
          {mapCountries.map(([iso]) => (
            <use class:list={['lx-ctry', { 'is-home': first.countries.includes(iso) }]} data-iso={iso} href={`#lx-shape-${iso}`} />
          ))}
          <!-- rivers and lakes: drawn by the script once map-detail.json has arrived -->
          <g class="lx-water" data-water></g>
          {items.map((it) => (
            <path class:list={['lx-ls', { 'is-on': it.code === first.code }]} data-ls={it.code} d={outlines[it.code].d} fill-rule="evenodd" vector-effect="non-scaling-stroke" pathLength="1" />
          ))}
          <g data-pin>
            <g class="lx-pin" data-pin-body>
              <circle class="lx-pin-pulse" r="14" />
              <circle class="lx-pin-ring" r="9" />
              <circle class="lx-pin-dot" r="3.5" />
            </g>
          </g>
        </svg>
        <svg class="lx-labels" data-labels aria-hidden="true"></svg>
        <span class="lx-map-label" data-map-label>{geoCountries[first.countries[0]]?.name}</span>
        <button type="button" class="lx-globe-btn" data-reset title="Zoom out to the whole country" aria-label="Zoom out to the whole country">
          <svg class="lx-globe" data-globe viewBox="-52 -52 104 104" aria-hidden="true">
            <circle class="lx-globe-sea" r="50" />
            <g data-globe-land></g>
            <path class="lx-globe-view" data-globe-view d="" />
            <circle class="lx-globe-dot" data-globe-dot r="3.2" />
            <circle class="lx-globe-rim" r="50" />
          </svg>
        </button>
        <div class="lx-zoom" role="group" aria-label="Map zoom">
          <button type="button" data-zoom="in" aria-label="Zoom in" title="Zoom in"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" /></svg></button>
          <button type="button" data-zoom="out" aria-label="Zoom out" title="Zoom out"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10" /></svg></button>
          <button type="button" data-zoom="fit" aria-label="Reset the view" title="Reset the view"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4" /></svg></button>
        </div>
        <p class="lx-hint" data-hint aria-hidden="true">Use Ctrl / ⌘ + scroll, or pinch, to zoom</p>
        <div class="lx-scale" aria-hidden="true">
          <svg width="110" height="16" data-scale><line x1="2" y1="12" x2="102" y2="12" /><line x1="2" y1="7" x2="2" y2="12" /><line x1="102" y1="7" x2="102" y2="12" /></svg>
          <span data-scale-label>—</span>
        </div>
        <div class="lx-north" aria-hidden="true">N<svg width="14" height="14" viewBox="0 0 14 14"><path d="M7 1 L12 13 L7 10 L2 13 Z" /></svg></div>
      </div>

      <!-- Key facts -->
      <div class="lx-facts lx-anim">
        <h3 class="lx-facts-title">Key insights</h3>
        <ul class="lx-fact-list">
          <li class="lx-fact">
            <span class="lx-fact-ic t-teal"><Icon name="mountains" size={22} /></span>
            <span><strong>Area</strong><span data-f="area">{first.area}</span></span>
          </li>
          <li class="lx-fact is-wide">
            <span class="lx-fact-ic t-light"><Icon name="grid" size={22} /></span>
            <div class="lx-cov">
              <strong>Data coverage</strong>
              <div class="lx-cov-row">
                <div class="lx-ring">
                  <svg viewBox="0 0 120 120" aria-hidden="true">
                    <circle class="lx-ring-track" cx="60" cy="60" r="50" />
                    <circle class="lx-ring-arc" data-f="cov-arc" cx="60" cy="60" r="50" pathLength="100" stroke-dasharray="0 100" transform="rotate(-90 60 60)" />
                  </svg>
                  <p class="lx-ring-text"><b data-f="cov-n">– of {themeList.length}</b><span>themes have data</span></p>
                </div>
                <div class="lx-cov-side">
                  <p class="lx-cov-open" data-f="cov-open" hidden>
                    <Icon name="folder" size={28} />
                    <span><b data-f="cov-open-n"></b><span data-f="cov-open-label">datasets are open access</span></span>
                  </p>
                  <ul class="lx-cov-legend">
                    <li><i class="is-on"></i><span>With data (<span data-f="cov-with">–</span>)</span></li>
                    <li><i></i><span>Missing (<span data-f="cov-miss">–</span>)</span></li>
                  </ul>
                </div>
              </div>
              <details class="lx-cov-missing" data-cov-missing hidden>
                <summary>Missing themes <span data-f="cov-miss-n"></span></summary>
                <ul data-f="cov-missing-list"></ul>
              </details>
            </div>
          </li>
