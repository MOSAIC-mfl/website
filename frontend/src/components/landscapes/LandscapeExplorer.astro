  .lx-country { display: flex; align-items: center; gap: var(--space-2); margin: 0; color: var(--color-text); font-size: var(--text-lg); flex-wrap: wrap; }
  .lx-country :global(svg) { color: var(--color-link); }
  .lx-pending {
    font-size: var(--text-xs); font-weight: 600; color: var(--mosaic-amber);
    background: var(--tint-amber-bg); padding: 0.1rem var(--space-2); border-radius: var(--radius-full);
  }
  .lx-badge {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-3) var(--space-6);
