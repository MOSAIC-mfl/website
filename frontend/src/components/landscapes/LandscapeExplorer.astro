    background: #DDE9E4; /* sea */
    border: 1px solid var(--color-border);
  }
  .lx-map-svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; touch-action: pan-x pan-y; user-select: none; }
  .lx-map-svg.is-dragging { cursor: grabbing; }
  .lx-zoom {
    position: absolute; left: var(--space-3); top: var(--space-3);
    display: flex; flex-direction: column;
    background: var(--color-white); border-radius: var(--radius-md); box-shadow: 0 2px 8px rgba(28, 43, 58, 0.18); overflow: hidden;
  }
  .lx-zoom button {
    width: 32px; height: 32px; display: grid; place-items: center; padding: 0;
    border: 0; background: var(--color-white); color: var(--mosaic-ink); cursor: pointer;
  }
  .lx-zoom button + button { border-top: 1px solid var(--color-border); }
  .lx-zoom button:hover { background: var(--mosaic-light-teal); color: var(--mosaic-teal); }
  .lx-zoom button:focus-visible { outline: 2px solid var(--mosaic-teal); outline-offset: -2px; }
  .lx-zoom button:disabled { opacity: 0.35; cursor: default; background: var(--color-white); }
  .lx-zoom path { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .lx-hint {
