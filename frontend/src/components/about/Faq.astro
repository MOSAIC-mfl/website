---
/* About › FAQ — moved here from the former /contribute page (2026-11-09). */
const using = [
  { q: 'What is a living landscape?', a: 'A real place — a river basin, a mountain range, a coastal delta — where farms, forests, water and the people who depend on them are looked at together, not one at a time. The CGIAR Multifunctional Landscapes Science Programme works in the ones listed on the Landscapes page.' },
  { q: 'Who runs MOSAIC?', a: 'MOSAIC is an initiative of the CGIAR Multifunctional Landscapes Science Programme. It is coordinated from the Alliance of Bioversity International and CIAT, and the records are registered and kept up to date by the people who hold the data, through the programme\'s Geospatial Community of Practice.' },
  { q: 'What do Open, Restricted and Internal mean?', a: 'Open: anyone can get the data without asking, through the source link on the dataset\'s page. Restricted: the organisation that holds the data decides who gets it — write to the contact on the dataset\'s page. Internal: for CGIAR staff only. The contributor sets the access level; MOSAIC shows it and never overrides it.' },
  { q: 'How do I get a restricted dataset?', a: 'Write to the contact shown on the dataset\'s page, saying which dataset you need and what for. The organisation that holds the data decides. MOSAIC does not hold the files and cannot grant access.' },
  { q: 'How do I cite a dataset?', a: 'Use the citation on the dataset\'s page when there is one. When there is not, cite the data as its source asks, and point to the catalogue record with its title, its record ID (for example MFL-2026-080) and its address.' },
  { q: 'How current is the catalogue?', a: 'The catalogue page shows the date it was last rebuilt. A record changes when its contributor sends a change; individual records do not carry their own date yet.' },
]

const contributing = [
  { q: 'Can an organisation outside CGIAR take part?', a: 'Yes. Anyone working on these landscapes can register a dataset: research institutions, universities, public agencies, NGOs, landscape initiatives and independent researchers. See How to contribute.' },
  { q: 'Do I need to upload my data files?', a: 'Not for now. Today MOSAIC is a catalogue: your data stays wherever it is hosted (a CGIAR data portal, an institutional server, a drive) and the record describes it and points to it. In a later phase, the plan is to make the open datasets themselves directly available through MOSAIC — datasets that already have a home will keep being linked at their source.' },
  { q: 'Can I register a dataset before the data is publicly available?', a: 'Yes. Register it with Internal or Restricted access: the dataset becomes discoverable while access itself stays managed through your centre\'s normal procedures.' },
  { q: 'What if my dataset doesn\'t fit the controlled vocabulary?', a: 'Contact the MOSAIC team (see Get in touch). The controlled vocabularies are reviewed periodically and new values can be proposed.' },
  { q: 'What does quality control check?', a: 'Quality control by the MOSAIC team is being piloted: opening and reading the data, checking the coordinate reference system, and confirming the spatial extent and time period against the record. Until a dataset has been through it, the readiness status on its page is the one its contributor declared. If issues appear, you are tagged on a GitHub issue — a dataset is never removed without notifying the contributor.' },
  { q: 'Can I update a dataset after it is published?', a: 'Yes. Open an update issue describing the change — or, if you use Git, edit the dataset\'s record file and open a pull request. Every change is validated before going live and each record\'s history stays visible.' },
  { q: 'Who owns the data — and the license?', a: 'Ownership stays with the contributing centre or organisation, now and in any future phase. Each record carries the license the contributor declares, and access-level decisions are the contributor\'s. (The website\'s own content is CC BY 4.0.)' },
]
---

<div class="faq-list">
  <h3 class="faq-h3">Using the catalogue</h3>
  {using.map((item) => (
    <details class="faq">
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
  <h3 class="faq-h3">Contributing</h3>
  {contributing.map((item) => (
    <details class="faq">
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq-list { max-width: 820px; }
  .faq-h3 { font-size: var(--text-xl); margin: var(--space-8) 0 var(--space-4); }
  .faq-h3:first-child { margin-top: 0; }
  .faq {
    border: 1px solid var(--color-border); border-radius: var(--radius-md);
    padding: var(--space-4); margin-bottom: var(--space-3); background-color: var(--color-surface);
  }
  .faq summary { cursor: pointer; font-weight: 600; color: var(--color-text); }
  .faq p { margin: var(--space-3) 0 0; color: var(--color-muted); line-height: 1.7; }
</style>
