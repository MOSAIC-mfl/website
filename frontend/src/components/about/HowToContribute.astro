---
/* About › How to contribute — moved here from the former /contribute page
   (2026-11-09; /contribute now redirects to /about#contribute).
   2026-11-27: the ways to register are shown side by side, with the same weight;
   "Register a dataset" leads to them instead of the GitHub form alone. */
import StepTimeline from '../ui/StepTimeline.astro'
import ContentCard from '../ui/ContentCard.astro'

// The catalogue's submission form (catalog repo — records/<ID>.yaml is
// the source of truth; submissions become validated record files via PR).
const newDatasetUrl = 'https://github.com/MOSAIC-mfl/catalog/issues/new?template=new_dataset.yml'
const updateIssueUrl = 'https://github.com/MOSAIC-mfl/catalog/issues/new'
// The catalog README's "Add or change a dataset" section: the current (standard v0.2) instructions.
const howToUrl = 'https://github.com/MOSAIC-mfl/catalog#add-or-change-a-dataset'
// The mosaic-contribute skill (mosaic-skills repo): a folder of datasets -> records, via an AI assistant.
const skillUrl = 'https://github.com/MOSAIC-mfl/mosaic-skills/tree/main/skills/mosaic-contribute'

const steps = [
  { num: '01', icon: 'upload', title: 'Register', body: 'Choose any of the four ways below. Four fields are required; everything else is optional, and empty is a valid answer.' },
  { num: '02', icon: 'eye', title: 'Review with you', body: 'The MOSAIC team turns your submission into a validated record and tags you to confirm the details.' },
  { num: '03', icon: 'check-circle', title: 'Published', body: 'Once you confirm, it is published automatically: a permanent ID, a metadata record and a page in the catalog.' },
]

// The ways to register, in the same card and with the same weight.
const routes = [
  {
    icon: 'sparkles', title: 'With an AI assistant', href: skillUrl, external: true,
    body: 'Your datasets are in a folder? The mosaic-contribute skill reads the files, asks only what they cannot tell and prepares the records for you. Works with Claude or any assistant that can run commands.',
  },
  {
    icon: 'file-text', title: 'Online form', href: newDatasetUrl, external: true,
    body: 'Fill in a short form with the four required fields. You need a free GitHub account.',
  },
  {
    icon: 'mail', title: 'By email', href: '#contact', external: false,
    body: 'No GitHub account, or a whole inventory? Email the four required fields, or your centre\'s spreadsheet, to the MOSAIC coordinator. We prepare the records for you.',
  },
  {
    icon: 'database', title: 'As a record file', href: howToUrl, external: true,
    body: 'Comfortable with Git? Copy a record file in the catalog repository, edit it and open a pull request. Validation runs automatically.',
  },
]

const required = [
  'Dataset title',
  'Living Landscape it covers (or country-wide / global)',
  'Country',
  'Contact person',
]

const recommended = [
  'A working download or source URL, so others can get the data',
  'Spatial resolution with units (e.g. "30 m") and the CRS (e.g. EPSG:4326)',
  'Temporal coverage, a license (e.g. CC BY 4.0) and file format(s)',
]
---

<p class="hc-lead">
  Register your dataset's metadata and it becomes an open, citable record, with a permanent ID, a
  metadata record and its own page in the catalog. <strong>Open to everyone working on living
  landscapes</strong>: research institutions, universities, public agencies, NGOs, landscape
  initiatives and independent researchers. Your files stay where they are: MOSAIC publishes
  metadata that points to them.
</p>
<div class="hc-actions">
  <a class="btn btn-primary" href="#ways-to-register">Register a dataset</a>
  <a class="btn btn-secondary" href="#contact">Ask before contributing</a>
</div>
<p class="hc-note">4 required fields · with an AI assistant, an online form, email or Git</p>

<h3 class="hc-h3">How registration works</h3>
<StepTimeline steps={steps} />

<h3 class="hc-h3" id="ways-to-register">Ways to register</h3>
<div class="hc-routes">
  {routes.map((r) => (
    <ContentCard icon={r.icon} title={r.title} href={r.href} target={r.external ? '_blank' : undefined} arrow>
      {r.body}
    </ContentCard>
  ))}
</div>

<div class="need-card">
  <div class="need-col">
    <h4>Required <span class="need-count">4 fields</span></h4>
    <ul>
      {required.map((item) => (
        <li><span class="need-tick req" aria-hidden="true">✓</span><span>{item}</span></li>
      ))}
    </ul>
  </div>
  <div class="need-col">
    <h4>Recommended</h4>
    <ul>
      {recommended.map((item) => (
        <li><span class="need-tick" aria-hidden="true">＋</span><span>{item}</span></li>
      ))}
    </ul>
    <p class="need-foot">Full field descriptions: <a href="#metadata">Metadata guide</a>.</p>
  </div>
</div>

<p class="hc-text hc-after">
  <strong>Updating a dataset already in the catalog?</strong>
  <a href={updateIssueUrl} target="_blank" rel="noopener noreferrer">Open an update issue</a> describing the change.
  Step-by-step instructions for every way:
  <a href={howToUrl} target="_blank" rel="noopener noreferrer">How to register a dataset</a>.
</p>

<style>
  .hc-lead { color: var(--color-muted); margin: 0 0 var(--space-6); max-width: var(--measure); }
  .hc-lead strong { color: var(--color-text); }
  .hc-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .hc-note { margin: var(--space-3) 0 var(--space-12); font-size: var(--text-sm); color: var(--color-muted); }
  .hc-h3 { font-size: var(--text-2xl); margin: var(--space-12) 0 var(--space-6); }
  .hc-note + .hc-h3 { margin-top: 0; }

  .need-card {
    display: grid; grid-template-columns: 1fr 1.3fr; gap: var(--space-8); align-items: start;
    margin-top: var(--space-12); padding: var(--space-8);
    background-color: var(--color-gray-50); border-radius: var(--radius-card);
  }
  .need-col h4 { margin: 0 0 var(--space-4); font-size: var(--text-xl); }
  .need-count {
    display: inline-block; margin-left: var(--space-2); padding: 2px 10px; border-radius: var(--radius-full);
    background-color: var(--tint-teal-bg); color: var(--tint-teal-fg);
    font-family: var(--font-body); font-size: var(--text-sm); font-weight: 600; vertical-align: middle;
  }
  .need-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .need-col li { display: flex; gap: var(--space-3); align-items: flex-start; line-height: 1.5; }
  .need-tick { flex-shrink: 0; font-weight: 700; color: var(--color-muted); }
  .need-tick.req { color: var(--color-link); }
  .need-foot { margin: var(--space-4) 0 0; font-size: var(--text-sm); color: var(--color-muted); }

  /* the anchor of the "Register a dataset" button: clear the sticky chip row on narrow screens too */
  @media (max-width: 900px) { #ways-to-register { scroll-margin-top: 3.5rem; } }
  .hc-routes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  .hc-text { color: var(--color-muted); margin: 0; max-width: var(--measure); }
  .hc-text strong { color: var(--color-text); }
  .hc-after { margin-top: var(--space-8); line-height: 1.6; }
  .hc-text a, .need-foot a { color: var(--color-link); }

  @media (max-width: 767px) {
    .need-card { grid-template-columns: 1fr; gap: var(--space-6); padding: var(--space-6); }
    .hc-routes { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  }
</style>
