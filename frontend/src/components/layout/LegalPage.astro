---
/* Shell of the two legal pages (Privacy notice, Terms of use), 2026-11-26. One narrow column of
   numbered sections, the version and its date under the title. Earlier versions stay in the
   repository's history; the page says so. A `<mark class="legal-todo">` marks a fact that only
   the responsible entity's legal team can supply: the page must not go live while one remains. */
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../ui/PageHero.astro'

interface Props {
  title: string
  description: string
  version: string
  /** ISO date the version takes effect */
  effective: string
}

const { title, description, version, effective } = Astro.props
const shown = new Date(`${effective}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
})
---

<BaseLayout title={title} description={description}>
  <PageHero variant="light" compact contours title={title} width="760px" />
  <article class="container legal">
    <p class="legal-version">Version {version} · in effect from <time datetime={effective}>{shown}</time></p>
    <slot />
    <p class="legal-history">
      Earlier versions of this page are kept in the
      <a href="https://github.com/MOSAIC-mfl/website/commits/main/frontend/src/pages">public history of the website</a>.
    </p>
  </article>
</BaseLayout>

<style>
  .legal { max-width: 760px; padding-top: var(--space-8); padding-bottom: var(--space-16); }
  .legal-version { color: var(--color-muted); font-size: var(--text-sm); margin: 0 0 var(--space-8); }
  .legal :global(h2) {
    font-size: var(--text-xl); margin: var(--space-8) 0 var(--space-3);
  }
  .legal :global(p), .legal :global(li) { max-width: var(--measure); }
  .legal :global(ul) { padding-left: var(--space-6); }
  .legal :global(li) { margin-bottom: var(--space-2); }
  .legal :global(mark.legal-todo) {
    background: var(--tint-amber-bg); color: var(--tint-amber-fg); padding: 0 var(--space-1); border-radius: var(--radius-sm);
    font-weight: 600;
  }
  .legal-history { margin-top: var(--space-12); color: var(--color-muted); font-size: var(--text-sm); }
</style>
