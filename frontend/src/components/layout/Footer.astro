---
const base = import.meta.env.BASE_URL
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-grid">
      <div class="footer-about">
        <div class="footer-brand">
          <img
            src={`${base}/mosaic-mark-reverse.svg`}
            alt=""
            width="38"
            height="25"
            aria-hidden="true"
          />
          <span class="footer-brand-name">MOSAIC</span>
        </div>
        <p class="footer-about-text">
          MOSAIC is an open spatial intelligence network for living landscapes. It connects data
          from institutions, researchers and landscape initiatives, with support from the CGIAR
          Multifunctional Landscapes Science Programme.
        </p>
      </div>

      <div class="footer-col">
        <p class="footer-col-title">Explore</p>
        <ul class="footer-links">
          <li><a href={`${base}/catalogue`}>Catalogue</a></li>
          <li><a href={`${base}/landscapes`}>Landscapes</a></li>
          <li><a href={`${base}/about`}>About</a></li>
          <li><a href={`${base}/contact`}>Contact</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col-title">Contribute</p>
        <ul class="footer-links">
          <li><a href={`${base}/contribute`}>How to contribute</a></li>
          <li><a href={`${base}/contribute/metadata-guide`}>Metadata Guide</a></li>
        </ul>
      </div>
    </div>

    <!-- ── CGIAR / MFL endorsement ──────────────────────────────────────
         Official "CGIAR Multifunctional Landscapes" lockup, used as supplied
         and shown in CGIAR's own colours on a neutral (light) panel so it
         reads as institutional endorsement — never restyled to the MOSAIC
         palette (MOSAIC Brand Guidelines v1.0, §5). -->
    <div class="footer-endorsement">
      <img
        src={`${base}/cgiar-mfl-lockup.png`}
        alt="CGIAR Multifunctional Landscapes"
        class="footer-endorsement-logo"
        width="200"
        height="67"
      />
      <p class="footer-endorsement-text">
        MOSAIC is an initiative of the <strong>CGIAR Multifunctional Landscapes
        Science Programme</strong> and is funded through it.
      </p>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} CGIAR MFL Science Programme. Content licensed under CC BY 4.0 unless otherwise stated.</p>
      <a href="https://github.com/MOSAIC-mfl/website">GitHub</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bookend);
    color: rgba(255, 255, 255, 0.8);
    margin-top: auto;
  }

  .footer-main {
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-6) var(--space-8);
    margin-bottom: var(--space-6);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .footer-brand-name {
    font-family: var(--font-title);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-white);
  }

  .footer-about-text {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    max-width: 46ch;
    margin: 0;
  }

  .footer-col-title {
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-3);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--mosaic-light-teal);
  }

  /* ── Endorsement panel ───────────────────────────────────────── */
  .footer-endorsement {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-6);
    margin-bottom: var(--space-4);
  }

  .footer-endorsement-logo {
    height: 67px;
    width: auto;
    flex-shrink: 0;
  }

  .footer-endorsement-text {
    font-size: var(--text-xs);
    line-height: 1.6;
    /* Literal grey (not a theme alias): the endorsement panel stays white in
       both themes, so its text must not flip light in dark mode. */
    color: #4B5563;
    margin: 0;
  }

  .footer-endorsement-text strong {
    color: var(--mosaic-ink);
  }

  /* ── Bottom bar ──────────────────────────────────────────────── */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: var(--space-4);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-xs);
    flex-wrap: wrap;
  }

  .footer-bottom p {
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }

  .footer-bottom a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .footer-bottom a:hover {
    color: var(--mosaic-light-teal);
  }

  @media (max-width: 767px) {
    .footer-grid { grid-template-columns: 1fr; gap: var(--space-6); }
    .footer-endorsement { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  }
</style>
