---
import Icon from '../ui/Icon.astro'
import landscapes from '../../../data/landscapes.json'

const base = import.meta.env.BASE_URL
const currentPath = Astro.url.pathname

const navLinks = [
  { href: `${base}/`, label: 'Home', exact: true },
  { href: `${base}/landscapes`, label: 'Landscapes', menu: true },
  { href: `${base}/catalogue`, label: 'Catalog' },
  { href: `${base}/about`, label: 'About' },
]

// Landscapes with a map viewer today. Whether a landscape has one is read from the API
// when its map page opens, but this menu is built with the site: add a code here when
// a new viewer is published. The others are listed as "Soon" (Lizeth, 2026-11-18).
const MAP_VIEWERS = ['KEN-LVB', 'PER-PCL']
const byName = (a: { name: string }, b: { name: string }) => a.name.localeCompare(b.name)
// One A–Z list, every row alike: a ready viewer is a link, the others carry "Soon".
const viewers = [...landscapes].sort(byName).map((l) => ({
  name: l.name,
  href: MAP_VIEWERS.includes(l.code) ? `${base}/landscapes/${l.code.toLowerCase()}/map/` : null,
}))

// Home must match exactly, otherwise it would light up on every page
// (every path starts with the base path).
function isActive(href: string, exact = false) {
  const path = currentPath.replace(/\/$/, '') || '/'
  const target = href.replace(/\/$/, '') || '/'
  return exact ? path === target : path === target || path.startsWith(target + '/')
}
---

<!-- Desktop nav (the skip-to-content link lives in Header.astro, ahead of the logo) -->
<nav aria-label="Main navigation" class="main-nav">
  <ul class="nav-list">
    {navLinks.map(link => link.menu ? (
      <li class="nav-dd">
        <button
          type="button"
          class="nav-link nav-dd-btn"
          aria-expanded="false"
          aria-controls="nav-landscapes-menu"
          data-active={isActive(link.href) ? 'true' : undefined}
        >{link.label} <Icon name="chevron-down" size={14} aria-hidden="true" /></button>
        <div class="nav-dd-panel" id="nav-landscapes-menu" hidden>
          <a class="nav-dd-link nav-dd-all" href={link.href}>All landscapes</a>
          <p class="nav-dd-head" id="nav-mv-head">Map viewers</p>
          <ul class="nav-dd-list" aria-labelledby="nav-mv-head">
            {viewers.map((v) => (
              <li>
                {v.href
                  ? <a class="nav-dd-row" href={v.href}>{v.name}</a>
                  : <span class="nav-dd-row">{v.name} <span class="nav-dd-tag">Soon</span></span>}
              </li>
            ))}
          </ul>
        </div>
      </li>
    ) : (
      <li>
        <a
          href={link.href}
          class="nav-link"
          aria-current={isActive(link.href, link.exact) ? 'page' : undefined}
        >{link.label}</a>
      </li>
    ))}
  </ul>
  <!-- The one action the menu names: registering a dataset lives inside About,
       two levels down, so it gets its own way in (2026-11-12). -->
  <a href={`${base}/about#contribute`} class="nav-cta">Contribute</a>
  <button
    type="button"
    class="theme-toggle js-theme-toggle"
    aria-label="Dark theme"
    aria-pressed="false"
  >
    <Icon name="sun" size={20} aria-hidden="true" />
    <Icon name="moon" size={20} aria-hidden="true" />
  </button>
</nav>

<!-- Mobile hamburger -->
<button
  type="button"
  class="hamburger"
  aria-label="Open navigation menu"
  aria-expanded="false"
  aria-controls="mobile-menu"
  id="hamburger-btn"
>
  <svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none">
    <path class="hamburger-open" d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path class="hamburger-close" d="M6 6l12 12M6 18L18 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none"/>
  </svg>
</button>

<!-- Mobile menu panel -->
<nav
  class="mobile-menu"
  id="mobile-menu"
  aria-label="Mobile navigation"
  hidden
>
  <ul class="mobile-nav-list">
    {navLinks.map(link => (
      <li>
        <a
          href={link.href}
          class="mobile-nav-link"
          aria-current={isActive(link.href, link.exact) ? 'page' : undefined}
        >{link.label}</a>
        {link.menu && (
          <div class="mobile-mv">
            <p class="mobile-mv-head" id="mobile-mv-head">Map viewers</p>
            <ul class="mobile-mv-list" aria-labelledby="mobile-mv-head">
              {viewers.map((v) => (
                <li>
                  {v.href
                    ? <a class="mobile-mv-row" href={v.href}>{v.name}</a>
                    : <span class="mobile-mv-row">{v.name} <span class="nav-dd-tag">Soon</span></span>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </li>
    ))}
    <li>
      <a href={`${base}/about#contribute`} class="mobile-nav-link">Contribute</a>
    </li>
  </ul>
  <button
    type="button"
    class="theme-toggle theme-toggle-mobile js-theme-toggle"
    aria-pressed="false"
  >
    <Icon name="sun" size={20} aria-hidden="true" />
    <Icon name="moon" size={20} aria-hidden="true" />
    <span class="theme-toggle-label">Dark theme</span>
  </button>

  <!-- CGIAR / MFL co-branding: on mobile the lockup lives here instead of the
       header bar. Official lockup used as supplied, on a white panel — the
       menu panel background is --color-white, which never flips dark. -->
  <div class="mobile-menu-cobrand">
    <img
      src={`${base}/cgiar-mfl-lockup.png`}
      alt="CGIAR Multifunctional Landscapes"
      width="2048"
      height="687"
    />
  </div>
</nav>

<style>
  /* ── Desktop nav ────────────────────────────────────── */
  .main-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* ── Theme toggle ───────────────────────────────────── */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-2);
    background: none;
    border: none;
    border-radius: var(--radius-md);
    color: rgba(255, 255, 255, 0.82);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }

  .theme-toggle:hover {
    color: var(--mosaic-light-teal);
    background-color: rgba(255, 255, 255, 0.1);
  }

  /* Keyboard focus. The header bar is teal, so a ring in Ocean Teal cannot be
     seen on it: controls on the bar take Light Teal. */
  .theme-toggle:focus-visible {
    outline: 2px solid var(--mosaic-light-teal);
    outline-offset: 2px;
  }
  /* …and the one in the mobile menu, whose panel is white, keeps Ocean Teal. */
  .theme-toggle-mobile:focus-visible {
    outline-color: var(--mosaic-teal);
    outline-offset: -2px;
  }

  /* Icon swap: show sun in light theme, moon in dark theme.
     Rules are global because [data-theme] lives on <html> and the
     <svg> glyphs are rendered by the Icon child component. */
  :global(.theme-toggle .icon-moon) { display: none; }
  :global([data-theme="dark"] .theme-toggle .icon-sun) { display: none; }
  :global([data-theme="dark"] .theme-toggle .icon-moon) { display: block; }

  .theme-toggle-label { display: none; }

  .theme-toggle-mobile {
    width: 100%;
    justify-content: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-6);
    border-radius: 0;
    color: var(--color-gray-700);
    font-size: var(--text-base);
    font-weight: 500;
  }

  .theme-toggle-mobile .theme-toggle-label { display: inline; }

  .theme-toggle-mobile:hover {
    background-color: var(--color-gray-50);
    color: var(--color-cgiar-teal);
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: var(--space-6);
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2) 0;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s, color 0.15s;
    min-height: 44px;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--mosaic-light-teal);
  }

  /* A ring as well as the colour: the current page's link is already white,
     so colour alone showed nothing when it had the focus. */
  .nav-link:focus-visible {
    outline: 2px solid var(--mosaic-light-teal);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .nav-link[aria-current="page"] {
    color: var(--color-white);
    border-bottom-color: var(--mosaic-light-teal);
    font-weight: 600;
  }

  /* ── Landscapes dropdown: all landscapes + the map viewers ── */
  .nav-dd { position: relative; }
  .nav-dd-btn :global(svg) { transition: transform 0.15s; }
  .nav-dd-btn[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }
  .nav-dd-btn[data-active='true'] {
    color: var(--color-white);
    border-bottom-color: var(--mosaic-light-teal);
    font-weight: 600;
  }
  /* White panel in both themes, like the mobile menu: brand colours that never flip. */
  .nav-dd-panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: calc(-1 * var(--space-4));
    z-index: 200;
    width: 340px;
    max-height: calc(100vh - var(--header-offset));
    overflow-y: auto;
    padding: var(--space-2) 0;
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }
  .nav-dd-panel[hidden] { display: none; }
  .nav-dd-list { list-style: none; margin: 0; padding: 0; }
  .nav-dd-link {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: var(--space-2) var(--space-4);
    color: var(--mosaic-ink);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .nav-dd-link:hover { background-color: var(--mosaic-sand); color: var(--mosaic-teal); }
  .nav-dd-link:focus-visible { outline: 2px solid var(--mosaic-teal); outline-offset: -2px; }
  .nav-dd-all { font-weight: 600; }
  .nav-dd-head {
    margin: var(--space-2) 0 0;
    padding: var(--space-2) var(--space-4) var(--space-1);
    border-top: 1px solid var(--color-gray-200);
    color: var(--mosaic-grey-text);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  /* Map-viewer rows: ready and coming look the same; only the Soon tag differs. */
  .nav-dd-row,
  .mobile-mv-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 36px;
    color: var(--mosaic-ink);
    font-size: var(--text-sm);
    font-weight: 400;
    text-decoration: none;
  }
  .nav-dd-row { padding: var(--space-1) var(--space-4); }
  a.nav-dd-row:hover, a.mobile-mv-row:hover { background-color: var(--mosaic-sand); color: var(--mosaic-teal); }
  a.nav-dd-row:focus-visible, a.mobile-mv-row:focus-visible { outline: 2px solid var(--mosaic-teal); outline-offset: -2px; }
  .nav-dd-tag {
    flex-shrink: 0;
    padding: 0.05rem var(--space-2);
    border-radius: var(--radius-full);
    background: var(--tint-amber-bg);
    color: var(--tint-amber-fg);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  /* ── "Contribute" button in the bar ─────────────────── */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 var(--space-4);
    border: 1.5px solid rgba(255, 255, 255, 0.7);
    border-radius: var(--radius-md);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }
  .nav-cta:hover {
    background-color: var(--mosaic-light-teal);
    border-color: var(--mosaic-light-teal);
    color: var(--color-bookend);
  }
  .nav-cta:focus-visible {
    outline: 2px solid var(--mosaic-light-teal);
    outline-offset: 3px;
  }

  /* ── Hamburger (hidden on desktop) ─────────────────── */
  .hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-white);
    padding: var(--space-2);
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
  }

  .hamburger:focus-visible {
    outline: 2px solid var(--mosaic-light-teal);
    outline-offset: 2px;
  }

  /* ── Mobile menu panel ──────────────────────────────── */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-white);
    z-index: 200;
    border-top: 1px solid var(--color-gray-200);
    border-bottom: 2px solid var(--color-cgiar-teal);
    box-shadow: 0 8px 24px rgba(28, 43, 58, 0.08);
    padding: var(--space-4) 0 var(--space-6);
  }

  .mobile-menu[hidden] { display: none; }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-nav-link {
    display: block;
    padding: var(--space-3) var(--space-6);
    color: var(--color-gray-700);
    text-decoration: none;
    font-size: var(--text-base);
    font-weight: 500;
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: background-color 0.1s, color 0.1s;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    background-color: var(--color-gray-50);
    color: var(--color-cgiar-teal);
  }

  /* On the white panel the ring is Ocean Teal, drawn inside the row */
  .mobile-nav-link:focus-visible {
    outline: 2px solid var(--mosaic-teal);
    outline-offset: -2px;
  }

  .mobile-nav-link[aria-current="page"] {
    color: var(--color-gray-900);
    font-weight: 600;
    border-left: 3px solid var(--color-cgiar-teal);
    padding-left: calc(var(--space-6) - 3px);
  }

  /* Map viewers under Landscapes in the mobile menu, indented */
  .mobile-mv { padding: 0 0 var(--space-2) var(--space-6); }
  .mobile-mv-head {
    margin: 0;
    padding: var(--space-1) var(--space-6) var(--space-1) var(--space-4);
    color: var(--mosaic-grey-text);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .mobile-mv-list { list-style: none; margin: 0; padding: 0; }
  .mobile-mv-row { padding: var(--space-1) var(--space-6) var(--space-1) var(--space-4); }

  .mobile-menu-cobrand {
    margin-top: var(--space-4);
    padding: var(--space-4) var(--space-6) 0;
    border-top: 1px solid var(--color-gray-200);
  }

  .mobile-menu-cobrand img {
    display: block;
    height: 34px;
    width: auto;
  }

  /* ── Mobile menu in the dark theme ──────────────────────
     The panel stays white in both themes (the CGIAR / MFL lockup is shown on
     a white ground), but its text and its hover fill used the neutral greys,
     which swap ends with the theme: near-white text on white, and a dark row
     on hover. In the dark theme they keep to brand colours that never change. */
  :global([data-theme='dark']) .mobile-nav-link,
  :global([data-theme='dark']) .theme-toggle-mobile {
    color: var(--mosaic-ink);
  }
  :global([data-theme='dark']) .mobile-nav-link:hover,
  :global([data-theme='dark']) .mobile-nav-link:focus-visible,
  :global([data-theme='dark']) .theme-toggle-mobile:hover {
    background-color: var(--mosaic-sand);
    color: var(--mosaic-teal);
  }
  :global([data-theme='dark']) .mobile-nav-link[aria-current='page'] {
    color: var(--mosaic-ink);
  }

  /* ── Responsive: show hamburger, hide desktop nav ──── */
  /* Intermediate widths (~768–1100px): tighten the link row so the header's
     logo + nav + toggle + lockup all fit on one line. */
  @media (max-width: 1099px) {
    .nav-list { gap: var(--space-4); }
  }
  @media (max-width: 919px) {
    .nav-list { gap: var(--space-3); }
    .nav-link { font-size: 0.8rem; }
    .nav-cta { font-size: 0.8rem; padding: 0 var(--space-3); }
  }
  @media (max-width: 767px) {
    .main-nav { display: none; }
    .hamburger { display: flex; }
  }
</style>

<script>
  // Landscapes dropdown (a disclosure: a button that shows a panel of links).
  // Click toggles it; Escape, a click outside or Tab out of it closes it.
  document.querySelectorAll<HTMLElement>('.nav-dd').forEach((dd) => {
    const btn = dd.querySelector<HTMLButtonElement>('.nav-dd-btn')
    const panel = dd.querySelector<HTMLElement>('.nav-dd-panel')
    if (!btn || !panel) return
    const isOpen = () => btn.getAttribute('aria-expanded') === 'true'
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open))
      panel.hidden = !open
    }
    btn.addEventListener('click', () => setOpen(!isOpen()))
    document.addEventListener('click', (e) => {
      if (isOpen() && !dd.contains(e.target as Node)) setOpen(false)
    })
    dd.addEventListener('focusout', (e) => {
      if (isOpen() && !dd.contains(e.relatedTarget as Node | null)) setOpen(false)
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false)
        btn.focus()
      }
    })
  })

  // Hamburger: toggle mobile menu
  const hamburger = document.getElementById('hamburger-btn')
  const mobileMenu = document.getElementById('mobile-menu')

  if (hamburger && mobileMenu) {
    // One place sets the state, so the button's name, icon and the menu always agree.
    const setOpen = (open: boolean) => {
      hamburger.setAttribute('aria-expanded', String(open))
      hamburger.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu')
      mobileMenu.hidden = !open
      hamburger.querySelectorAll('.hamburger-open').forEach(p => ((p as HTMLElement).style.display = open ? 'none' : ''))
      hamburger.querySelectorAll('.hamburger-close').forEach(p => ((p as HTMLElement).style.display = open ? '' : 'none'))
    }
    hamburger.addEventListener('click', () => setOpen(hamburger.getAttribute('aria-expanded') !== 'true'))

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && hamburger.getAttribute('aria-expanded') === 'true') {
        setOpen(false)
        hamburger.focus()
      }
    })
  }
</script>
