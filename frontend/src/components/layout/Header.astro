---
import Nav from './Nav.astro'
const base = import.meta.env.BASE_URL
---

<header class="site-header">
  <div class="container site-header-inner">
    <a href={base} class="site-logo" aria-label="MOSAIC — home">
      <img
        src={`${base}/mosaic-mark-reverse.svg`}
        alt=""
        class="site-logo-mark"
        width="40"
        height="26"
        aria-hidden="true"
      />
      <span class="site-logo-name">MOSAIC</span>
    </a>

    <Nav />

    <!-- CGIAR / MFL co-branding. The official lockup is used as supplied,
         directly on the header bar (no white chip, Lizeth 2026-11-10): its two
         blocks carry their own CGIAR greens. Hidden < 768px — it moves into the
         mobile menu panel instead (see Nav.astro). -->
    <div class="site-cobrand">
      <img
        src={`${base}/cgiar-mfl-lockup.png`}
        alt="CGIAR Multifunctional Landscapes"
        class="site-cobrand-img"
        width="2048"
        height="687"
      />
    </div>
  </div>
</header>

<style>
  /* Teal header — matches the footer (var(--mosaic-teal), Ocean Teal) so the
     two MOSAIC "bookends" of the page share the same colour, in both themes. */
  .site-header {
    background-color: var(--color-bookend);
    border-bottom: 3px solid var(--mosaic-teal-dark);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 12px rgba(0, 0, 0, 0.18);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    /* Squeezes gently at intermediate widths so logo + nav + toggle + lockup
       never collide (see the 768–1100px adjustments below). */
    gap: clamp(var(--space-3), 2vw, var(--space-6));
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-white);
    flex-shrink: 0;
  }

  .site-logo:focus-visible {
    outline: 2px solid var(--mosaic-teal);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .site-logo-mark {
    height: 26px;
    width: auto;
    flex-shrink: 0;
  }

  .site-logo-name {
    font-family: var(--font-title);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-white);
  }

  /* ── CGIAR / MFL lockup chip (far right of the bar on desktop) ────── */
  .site-cobrand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-cobrand-img {
    display: block;
    height: 38px;
    width: auto;
  }

  /* Intermediate widths (~768–1100px): shrink the lockup and tagline in two
     steps so the row keeps fitting without wrapping or collisions. */
  @media (max-width: 1099px) {
    .site-cobrand-img { height: 30px; }
  }
  @media (max-width: 919px) {
    .site-cobrand { padding: 3px 8px; }
    .site-cobrand-img { height: 26px; }
    .site-logo-mark { height: 22px; }
  }

  /* < 768px the nav collapses to the hamburger; the lockup moves into the
     mobile menu panel (Nav.astro) so the bar never crowds. */
  @media (max-width: 767px) {
    .site-cobrand { display: none; }
  }
</style>
