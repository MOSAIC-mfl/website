---
import Icon from '../ui/Icon.astro'

interface Props {
  code: string
  name: string
  country: string
  count: number
  href: string
  /** Landscape name still pending confirmation with the country team (e.g. PER-PCL). */
  pending?: boolean
  /** Boundary file of this landscape (Shapefile ZIP). */
  download?: { href: string; size: string }
}

const { code, name, country, count, href, pending = false, download } = Astro.props
---

<article class="landscape-card">
  <div class="landscape-card-head">
    <span class="landscape-code">{code}</span>
    <span class="landscape-count">
      {count === 0 ? 'No datasets yet' : `${count} ${count === 1 ? 'dataset' : 'datasets'}`}
    </span>
  </div>

  <h3 class="landscape-name">
    {name}{pending && <span class="landscape-pending">(pending confirmation)</span>}
  </h3>
  <p class="landscape-country">{country}</p>

  <div class="landscape-actions">
    <a class="landscape-browse" href={href}>
      Browse datasets
      <Icon name="arrow-right" size={16} />
    </a>
    {download && (
      <a
        class="landscape-download"
        href={download.href}
        aria-label={`Download the ${name} boundary (Shapefile ZIP, ${download.size})`}
        title={`Shapefile ZIP, ${download.size}, with README and credit`}
      >
        <Icon name="download" size={15} />
        Boundary
      </a>
    )}
  </div>

  <svg class="landscape-hills" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 120 V70 Q70 40 150 60 T300 50 T400 64 V120 Z" fill="currentColor" opacity="0.10" />
    <path d="M0 120 V86 Q90 60 190 78 T400 76 V120 Z" fill="currentColor" opacity="0.16" />
  </svg>
</article>

<style>
  .landscape-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    min-height: 200px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .landscape-card:hover,
  .landscape-card:focus-within {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
  }

  .landscape-card-head {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .landscape-code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--mosaic-teal);
    background-color: var(--mosaic-light-teal);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }

  .landscape-count {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .landscape-name {
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: var(--text-xl);
    font-family: var(--font-title);
    color: var(--color-text);
    line-height: 1.25;
  }

  .landscape-country {
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .landscape-pending {
    display: inline-block;
    margin-left: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    font-style: italic;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .landscape-actions {
    margin-top: auto;
    padding-top: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .landscape-browse {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--mosaic-teal);
    text-decoration: none;
  }
  /* The browse link covers the whole card, so the card stays one big target;
     the download link sits above it. */
  .landscape-browse::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .landscape-browse:focus-visible {
    outline: 2px solid var(--mosaic-teal);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .landscape-download {
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--mosaic-teal);
    background-color: var(--color-surface);
    border: 1px solid var(--mosaic-teal);
    border-radius: var(--radius-md);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s, color 0.15s;
  }
  .landscape-download:hover {
    background-color: var(--mosaic-teal);
    color: var(--color-white);
  }
  .landscape-download:focus-visible {
    outline: 2px solid var(--mosaic-teal);
    outline-offset: 2px;
  }

  .landscape-hills {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 90px;
    color: var(--mosaic-teal);
    pointer-events: none;
  }
</style>
