---
/* Art of "What is a living landscape?" (2026-11-20): the paper illustration builds itself layer by
   layer (sky, mountains, hills, ground, then each part with its medallion, then the arc and the
   caption), holds on the full picture and loops. The still is the page's image and the animation's
   last frame: it shows without script, with reduced motion, and until the section is on screen. The
   animation starts when the section is in view and pauses when it leaves. Layers and positions:
   public/illustrations/living-landscape/ and living-landscape-pieces.json; the timeline is
   src/lib/ui/living-landscape-timeline.ts. */
const base = import.meta.env.BASE_URL
const dir = `${base}/illustrations/living-landscape`
---

<div class="lla" data-dir={dir}>
  <img
    class="lla-still"
    src={`${dir}/still.webp`}
    alt="Paper illustration of a living landscape under a dome of sky: hills, a river, a forest, flowers and a butterfly, a farmhouse with two cows, wheat fields over layers of soil, and the sun. Around it, seven medallions linked by a dashed arc name its parts: water, forests, biodiversity, people and livelihoods, agriculture, land and soils, and climate. Caption: A connected socio-ecological system."
    width="1116"
    height="750"
    loading="lazy"
    decoding="async"
  />
  <div class="lla-scene" aria-hidden="true"></div>
</div>

<style>
  .lla { position: relative; }
  .lla-still {
    position: relative; z-index: 1;
    display: block; width: 100%; height: auto;
    transition: opacity 250ms linear;
  }
  .lla.is-playing .lla-still { opacity: 0; }
  .lla.is-playing.is-holding .lla-still { opacity: 1; }
  .lla-scene {
    position: absolute; left: 0; top: 0; width: 1116px; height: 750px;
    transform-origin: 0 0; visibility: hidden;
  }
  .lla.is-playing .lla-scene { visibility: visible; }
  /* layers are added by the script, so they need :global() */
  .lla-scene :global(img) {
    position: absolute; display: block; max-width: none;
    opacity: 0; pointer-events: none; user-select: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .lla-scene { display: none; }
    .lla .lla-still { opacity: 1; }
  }
</style>

<script>
  import manifest from './living-landscape-pieces.json'
  import { CYCLE, FADE_OUT, SETTLE, buildTimeline, pose } from '../../lib/ui/living-landscape-timeline'

  interface Layer { id: string; src: string; x: number; y: number; w: number; h: number; z: number }
  const layers = manifest.pieces as Layer[]
  const cues = buildTimeline(layers.map((l) => l.id))

  function setup(root: HTMLElement): void {
    const scene = root.querySelector<HTMLElement>('.lla-scene')
    if (!scene) return
    const dir = root.dataset.dir ?? ''
    const els = new Map<string, HTMLImageElement>()
    let loaded: Promise<unknown> | null = null
    let ready = false, inView = false, running = false
    let t = 0, last = 0

    const load = (): Promise<unknown> => {
      if (loaded) return loaded
      for (const l of [...layers].sort((a, b) => a.z - b.z)) {
        const im = new Image()
        im.src = `${dir}/${l.src}`
        im.alt = ''
        im.draggable = false
        Object.assign(im.style, { left: `${l.x}px`, top: `${l.y}px`, width: `${l.w}px`, height: `${l.h}px` })
        scene.appendChild(im)
        els.set(l.id, im)
      }
      // decode every layer before the first frame, so none arrives late
      loaded = Promise.all([...els.values()].map((im) => im.decode().catch(() => undefined)))
      return loaded
    }

    const render = (time: number): void => {
      // after the hold, the whole picture fades out before the next loop
      scene.style.opacity = time >= FADE_OUT ? String(Math.max(0, 1 - (time - FADE_OUT) / (CYCLE - FADE_OUT - 0.1))) : '1'
      for (const c of cues) {
        const el = els.get(c.id)
        if (!el) continue
        const q = pose(c, (time - c.t0) / c.dur)
        el.style.opacity = String(q.opacity)
        el.style.transform = q.ty ? `translateY(${q.ty.toFixed(2)}px)` : ''
      }
      root.classList.toggle('is-holding', time >= SETTLE && time < FADE_OUT)
    }

    const tick = (now: number): void => {
      if (!running) return
      t += Math.min(0.1, (now - last) / 1000) // a hidden tab does not jump ahead
      last = now
      if (t >= CYCLE) t = 0
      render(t)
      requestAnimationFrame(tick)
    }
    const play = (): void => {
      if (running || !ready || !inView) return
      running = true
      root.classList.add('is-playing')
      last = performance.now()
      requestAnimationFrame(tick)
    }

    new ResizeObserver(() => {
      scene.style.transform = `scale(${root.clientWidth / manifest.width})`
    }).observe(root)

    // load the layers a little before the section scrolls into view; play while it is in view
    new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        void load().then(() => { ready = true; play() })
      }
    }, { rootMargin: '300px 0px' }).observe(root)
    new IntersectionObserver((entries) => {
      inView = entries.some((e) => e.isIntersecting)
      if (inView) play()
      else running = false
    }, { threshold: 0.35 }).observe(root)
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    for (const root of document.querySelectorAll<HTMLElement>('.lla')) setup(root)
  }
</script>
